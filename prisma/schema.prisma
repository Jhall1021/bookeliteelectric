// BookEliteElectric.com — Prisma schema
// Implements the data architecture from the approved Phase 0 plan.
// Decision trees, pricing, and routing live as DATA here — not hardcoded pages.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Neon
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ServiceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  icon      String? // icon key, e.g. "outlet", "lighting", "fan"
  sortOrder Int      @default(0)
  // Lets New Outlets visually cluster near Outlets & Switches in the UI
  // without merging the underlying category/service data.
  navGroup  String?
  services  Service[]

  @@map("service_categories")
}

enum BookingType {
  INSTANT // resolves to a fixed price immediately
  ADJUSTED // fixed price with defined surcharge branches
  REMOTE_QUOTE // photos + info -> office prices it -> customer approves
  TROUBLESHOOT_ONLY // the $249 diagnostic service itself
}

// Handoff §6 — every service declares one photo state.
//   NONE            no customer photos (standard powered swaps, detectors)
//   PREPARATION     photos help us arrive prepared, price already locked;
//                   pairs with AnswerOption.photosBlockBooking = false
//   REVIEW_REQUIRED photos gate the price; office reviews, then quotes
/// What a route-access answer MEANS to the pricing engine, independent of how
/// the question was worded.
///
/// Six questions across the catalog ask whether there's an open path to run
/// wiring — attic_access, ceiling_access, below_above_access, outlet_access,
/// attic_basement_access, dedicated_route_access — using three different
/// answer vocabularies. A component conditioned on "accessible" silently
/// failed to match an answer of "has_access", and the switch-leg price fell
/// through to review on three services without anyone noticing.
///
/// Rather than teaching every component every synonym, the ANSWER declares
/// what it means. Components condition on the classification, so adding a new
/// access question later requires no component changes.
///
/// The raw answer keeps its detail: a snapshot still records
/// "unfinished_basement" and the job sheet still says so. Only the pricing
/// engine works in these three terms.
enum AccessClassification {
  ACCESSIBLE
  FINISHED
  UNKNOWN
}

enum PhotoState {
  NONE
  PREPARATION
  REVIEW_REQUIRED
}

/// What homeowners typed into "tell us what you need", and what we made of it.
///
/// Doing three jobs at once, which is why it's one table:
///
///   CACHE — the same sentences repeat endlessly. "outlet not working" will
///   be typed thousands of times, and there's no reason to ask a model twice.
///
///   EVIDENCE — which services are named in words nobody uses, what work
///   people want that isn't offered, where matching is wrong. Worth more than
///   the feature itself, and across contractors it's what makes routing
///   better over time.
///
///   SAFETY AUDIT — every query that tripped the emergency screen, so the
///   patterns can be checked against what people actually write.
///
/// Stores the phrasing and nothing else. No name, no address, no session —
/// there is no reason to know WHO asked, only what was asked.
model ServiceQuery {
  id String @id @default(cuid())

  /// Lowercased, punctuation stripped, whitespace collapsed. The cache key.
  normalizedText String @unique
  /// A few real phrasings behind that key, for reading back later.
  rawExamples String[]

  /// Slug rather than a relation: a service can be deleted and the record of
  /// people asking for it is still the useful part.
  matchedServiceSlug String?
  confidence Float?
  isEmergency Boolean @default(false)
  outOfScope  Boolean @default(false)

  timesAsked    Int @default(1)
  /// Went on to the suggested service.
  timesAccepted Int @default(0)
  /// Browsed instead — the suggestion was wrong or unconvincing.
  timesRejected Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchedServiceSlug])
  @@index([isEmergency])
  @@map("service_queries")
}

/// When crews are available to be booked.
///
/// Deliberately OURS, not derived from the contractor's scheduling software.
/// A contractor's FSM might hold all sorts of shifts, on-call rotas and
/// personal calendars; what we need is the simpler question of when this
/// website may offer an appointment. Jobber then tells us who's already busy
/// inside those hours.
///
/// Singleton, like PricingSettings — id is always "default".
model BusinessHours {
  id String @id @default("default")

  /// Days bookings may be offered. 0 = Sunday through 6 = Saturday.
  /// Also defines a "business day" for lead-time rules.
  workingDays Int[] @default([1, 2, 3, 4, 5])

  /// Wall-clock, 24h, in the contractor's local time.
  dayStart String @default("08:00")
  dayEnd   String @default("16:30")

  /// Length of an arrival window. Windows are generated from dayStart in
  /// blocks of this size; whatever is left at the end becomes the final
  /// window, which is why 8:00-16:30 in 3h blocks gives 8-11, 11-2, 2-4:30.
  windowMinutes Int @default(180)

  /// A leftover shorter than this is folded into the previous window rather
  /// than offered on its own — nobody wants a twenty-minute arrival window.
  minWindowMinutes Int @default(60)

  updatedAt DateTime @updatedAt

  @@map("business_hours")
}

/// Reference data: every ZIP code, with its town, county and state.
///
/// Not Elite's service area — the whole table, imported once. A contractor
/// then picks counties from it, which is how this works for the next
/// contractor in a different state without a code change.
///
/// `type` matters more than it looks: PO Box and single-entity ZIPs can't be
/// a home address, so they're imported but excluded from selection by
/// default. They were the source of every disagreement between sources on how
/// many ZIPs a county has.
model ZipCode {
  zip      String  @id
  city     String
  county   String
  state    String
  /// STANDARD, PO_BOX, UNIQUE, or MILITARY.
  type     String  @default("STANDARD")
  /// Population, where known. Zero or null means nobody lives there.
  population Int?

  @@index([state, county])
  @@index([county])
  @@map("zip_codes")
}

/// A part Elite buys, priced once and referenced by every service using it.
///
/// Services previously carried a single materialCostCents — the exterior GFCI
/// held 5244, with the breakdown of what that covered living only in a code
/// comment. A price rise on GFCI receptacles meant hunting through seeds for
/// which totals silently included one.
///
/// Itemized instead: change the receptacle here and every service using it
/// reprices. Invisible to customers; the pricing engine still sees one
/// assembled total per service, with the §4 tier applied to that total rather
/// than to each part.
model Material {
  id          String  @id @default(cuid())
  /// Stable identifier for seeds and code, e.g. GFCI_WEATHER_RESISTANT.
  key         String  @unique
  name        String
  /// What Elite pays, in cents. Markup is applied downstream by the tier
  /// rule, never baked in here.
  unitCostCents Int
  /// "each", "ft", "box" — display only; quantity does the arithmetic.
  unit        String  @default("each")
  notes       String?
  active      Boolean @default(true)
  services    ServiceMaterial[]

  @@map("materials")
}

/// Join: how much of a material a service consumes.
model ServiceMaterial {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  /// Supports fractional quantities — 2 ft of cable, half a box of staples.
  quantity   Float    @default(1)
  order      Int      @default(0)

  @@unique([serviceId, materialId])
  @@map("service_materials")
}

/// Reusable photo requirement groups.
///
/// Photo labels were being written out by hand in every seed script — 51
/// separate usages across four files, already with two different wordings for
/// the same panel photo. That's how the universal safety instruction ("open
/// the door only, never remove the dead front") ends up missing from one flow
/// because whoever wrote it forgot.
///
/// A group is named once and referenced. Correcting a wording, or adding the
/// safety line, happens in one place and applies everywhere.
model PhotoGroup {
  id          String  @id @default(cuid())
  /// Stable identifier used in code and seeds, e.g. PANEL_PHOTOS.
  key         String  @unique
  name        String
  /// The labels shown to the customer, in order.
  labels      String[]
  /// Prepended to every label in this group. Carries the panel safety rule so
  /// it can never be omitted by accident.
  safetyNote  String?
  active      Boolean @default(true)
  notes       String?
  options     AnswerOptionPhotoGroup[]

  @@map("photo_groups")
}

/// Join: an answer requests one or more photo groups.
model AnswerOptionPhotoGroup {
  id             String       @id @default(cuid())
  answerOptionId String
  answerOption   AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)
  photoGroupId   String
  photoGroup     PhotoGroup   @relation(fields: [photoGroupId], references: [id])
  order          Int          @default(0)

  @@unique([answerOptionId, photoGroupId])
  @@map("answer_option_photo_groups")
}

/// Text shown only when an earlier answer means it applies.
///
/// The fourth bespoke version of this was about to be built. Each one —
/// accessFinishedDisclaimer, the switch-leg acknowledgement, the fixture
/// acknowledgement — does the same job: show this sentence when the route
/// established earlier was finished. Written per tree, they drift; a customer
/// with an attic gets told we'll cut their ceiling because one copy wasn't
/// updated.
///
/// Defined once, attached where it applies, evaluated against the
/// classification the flow has already established.
model ConditionalDisclaimer {
  id        String @id @default(cuid())
  key       String @unique
  name      String
  /// Shown to the customer when the condition holds.
  text      String
  /// Only render when the access classification matches. Null means always.
  accessClass AccessClassification?
  active    Boolean @default(true)
  notes     String?
  options   AnswerOptionDisclaimer[]
  questions QuestionDisclaimer[]

  @@map("conditional_disclaimers")
}

/// Conditional text on a QUESTION rather than an answer — help text that's
/// only true on one route. The distance question tells customers to estimate
/// the path "through the basement or attic", which reads as nonsense once
/// they've said there isn't one.
model QuestionDisclaimer {
  id           String                @id @default(cuid())
  questionId   String
  question     Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  disclaimerId String
  disclaimer   ConditionalDisclaimer @relation(fields: [disclaimerId], references: [id])
  /// When true this REPLACES the question's help text rather than appending
  /// to it — for cases where the default is actively wrong on this route.
  replacesHelpText Boolean @default(false)
  order        Int                   @default(0)

  @@unique([questionId, disclaimerId])
  @@map("question_disclaimers")
}

model AnswerOptionDisclaimer {
  id             String                @id @default(cuid())
  answerOptionId String
  answerOption   AnswerOption          @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)
  disclaimerId   String
  disclaimer     ConditionalDisclaimer @relation(fields: [disclaimerId], references: [id])
  order          Int                   @default(0)

  @@unique([answerOptionId, disclaimerId])
  @@map("answer_option_disclaimers")
}

/// Reusable named job components (handoff §13-§14).
///
/// A component is a bundle of real work — technician-hours, direct material,
/// and calendar time — that can be attached to a route without duplicating the
/// figures in every tree that needs it. §13's switch-leg values are used by
/// recessed lighting, new ceiling lights, new fans and new exterior locations;
/// defining them once means a labor revision happens in one place.
///
/// Deliberately NOT a dollar amount. A flat modifier can't be repriced when the
/// tech-hour rate changes, can't have the §4 material markup applied to it, and
/// contributes nothing to the tech-hours the job actually consumes — so
/// dispatch would stay wrong. Components carry inputs; price is derived.
model JobComponent {
  id                   String  @id @default(cuid())
  /// Stable identifier used in code and seeds, e.g.
  /// NEW_SWITCH_AND_SWITCH_LEG_ACCESSIBLE
  key                  String  @unique
  /// Internal label for the admin editor.
  name                 String
  /// Optional plain-language line for the customer's scope summary, e.g.
  /// "New wall switch & control wiring". Null hides it from the customer.
  customerFacingLabel  String?
  /// Incremental technician-hours this component adds (handoff §3.1).
  addFieldLaborHours   Float   @default(0)
  /// Incremental direct material cost in cents, BEFORE markup. The §4 tier is
  /// applied to the assembled total, not per component.
  addMaterialCostCents Int     @default(0)
  /// Incremental calendar minutes. Independent of labor hours on purpose: a
  /// second technician doubles the hours without changing the clock time, and
  /// some work adds setup time without adding hours. Never derive one from
  /// the other.
  addScheduleMinutes   Int     @default(0)
  /// Rarely used — a component that changes the crew size.
  addTechCount         Int     @default(0)
  /// Approved customer-facing price for this component, in cents.
  ///
  /// Lives here rather than on the answer because the price belongs to the
  /// WORK, not to the question that selects it. §13.2's two variants —
  /// accessible and finished — are selected by the same answer but cost
  /// different amounts, so one figure on the answer could never be right for
  /// both.
  ///
  /// NULL means not yet approved: any route selecting this component goes to
  /// review instead of publishing a calculated figure. Zero is a valid
  /// approved value for work that adds no charge.
  approvedPriceCents   Int?
  active               Boolean @default(true)
  notes                String?
  options              AnswerOptionComponent[]

  @@map("job_components")
}

/// Join: an answer selects one or more components.
model AnswerOptionComponent {
  id             String       @id @default(cuid())
  answerOptionId String
  answerOption   AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)
  componentId    String
  component      JobComponent @relation(fields: [componentId], references: [id])
  /// Multiplier for per-unit components — e.g. 5 additional recessed lights
  /// against a single "additional light" component (§11-§12).
  quantity       Int          @default(1)

  /// Condition on the ACCESS CLASSIFICATION of an earlier answer rather than
  /// its raw value. Preferred for anything access-dependent: it survives
  /// rewording, and a new access question needs no component changes.
  conditionAccessClass AccessClassification?

  /// Optional condition on a PREVIOUSLY COLLECTED answer (handoff §29).
  ///
  /// §13.2 and §13.3 each define two variants of the same work — accessible
  /// versus finished — and which applies depends on the access answer the
  /// customer already gave. Asking again is explicitly forbidden, so instead
  /// one answer carries both variants, each conditioned on that earlier value.
  ///
  /// Null on both fields means the component always applies. When set, the
  /// component is included only if answers[conditionAnswerKey] equals
  /// conditionAnswerValue.
  ///
  /// If an answer carries only conditional components and NONE match — the
  /// access condition was never established — the route goes to review rather
  /// than silently booking without the work.
  conditionAnswerKey   String?
  conditionAnswerValue String?

  @@unique([answerOptionId, componentId])
  @@map("answer_option_components")
}

model Service {
  id                  String          @id @default(cuid())
  slug                String          @unique
  name                String
  categoryId          String
  category            ServiceCategory @relation(fields: [categoryId], references: [id])
  bookingType         BookingType
  basePrice           Int? // cents; null when Remote Quote has no anchor price
  startingPriceLabel  String? // e.g. "From $1,295" for remote-quote services
  whileWeThereBasePrice Int?
  heroImage           String?
  shortDescription     String?
  // Optional override for the category's icon — e.g. "Outlets & Switches"
  // needs both an outlet icon and a switch icon, not one icon for the
  // whole category. Falls back to ServiceCategory.icon when null.
  icon                String?
  requiresTechCount   Int             @default(1)
  // Labor/material composition, imported from the client's validated
  // pricing engine (Excel workbook, external tool). Null on any service
  // that hasn't been through that validation yet — those are simply
  // skipped by the "Recalculate All Prices" admin action rather than
  // guessed at. When present, basePrice/whileWeThereBasePrice are treated
  // as DERIVED from these numbers via PricingSettings, not independently
  // authoritative — editing base/WWT price directly in the Service Editor
  // still works, but a future recalculation will overwrite it using these.
  // --- LEGACY pricing composition (retained deliberately) ----------------
  // These reproduce the CURRENTLY PUBLISHED prices and record how those
  // numbers were reached. They are NOT real field hours: 44 of 45 services
  // store a value that doesn't equal estimatedMinutes x techs, because they
  // were back-fitted to land on a target price. Handoff §3.1 prohibits that
  // going forward, so new work uses fieldLaborHours below. Do not rename
  // these — that would assert the old numbers are measured, which they aren't.
  primaryLaborUnits   Float?
  addOnLaborUnits     Float?
  materialCostCents   Int?
  // Deliberate exception to the global material tier. NULL is the NORMAL
  // state and means "use the current tier" (§4: under $10 -> 3.00x,
  // $10.00-750.00 inclusive -> 1.30x, over $750 -> 1.20x).
  //
  // A non-null value means an admin intentionally overrode the markup, and
  // materialMultiplierReason should say why. Legacy values imported from the
  // workbook are NOT deliberate overrides — they're unvalidated data sitting
  // in this column. Itemizing a service's materials clears it, since that's
  // the moment its figures become real.
  materialMultiplier  Float?

  // Why the multiplier above departs from the tier. Without it, nobody can
  // tell six months from now whether a 2.5 was a business decision or
  // leftover from the import.
  materialMultiplierReason String?
  permitAdminCents    Int?
  otherDirectCostCents Int?

  // --- Handoff §3.1: real labor, separate from dispatch duration ---------
  // Actual expected technician-hours. NULL means "not yet established" — the
  // editor shows that rather than a suggested price derived from a number
  // nobody stands behind. Never populate this from estimatedMinutes.
  fieldLaborHours     Float?
  // Incremental hours once the tech is already on site. Handoff §3.4: WWT
  // pricing does NOT apply the primary service-call minimum.
  wwtLaborHours       Float?
  // False until someone has confirmed estimatedMinutes is a real dispatch
  // duration. Several look optimistic — Professional TV Installation is
  // recorded at 60 minutes for a one-tech mount-plus-receptacle-plus-cable
  // package — so they're treated as unreviewed until checked.
  estimatedMinutesReviewed Boolean @default(false)
  // Handoff §3.3: the $250 service-call minimum recovers the cost of
  // originating a visit. An add-on-only item never originates one, so the
  // minimum must not apply. The two Elite TV mounts are the current example:
  // applied literally it would push a $50 mount to $315.
  isPrimaryEligible   Boolean @default(true)
  // Handoff §6 — explicit, rather than inferred from route actions.
  photoState          PhotoState @default(NONE)
  // Set when an admin explicitly approves a calculated price for publication.
  // Handoff §5/§31: calculated prices are recommendations; nothing overwrites
  // a published price silently.
  publishedPriceApprovedAt DateTime?

  /// Itemized materials. When any exist they are the source of truth and
  /// materialCostCents is derived from them; the flat field remains for
  /// services not yet itemized.
  materials ServiceMaterial[]

  /// Display order within its category. Services previously sorted by name,
  /// which put "200-Amp Service Upgrade" above everything alphabetically
  /// regardless of how often anyone books it.
  sortOrder Int @default(0)
  active              Boolean         @default(true)
  // Shown alongside the price on services with NO question tree at all —
  // a flat price that still needs a caveat attached (e.g. "we don't move
  // built-in ovens"). AnswerOption.disclaimer covers the same need for
  // services that DO branch; this covers the simple flat-price case where
  // there's no branch to attach it to.
  disclaimer          String?
  // INTERNAL ONLY — never exposed in any customer-facing API response.
  // Used to estimate technician time on-site for scheduling/dispatch.
  // The guided-flow answers can push a job into a harder tier (e.g. New
  // Outlet's finished-wall-fishing branch), but this single estimate is a
  // per-service baseline; a future refinement could vary it per branch the
  // same way pricing does.
  estimatedMinutes    Int?

  questions    Question[]
  pricingRules PricingRule[]
  lineItems    LineItem[]
  quotes       Quote[]
  // Answer options elsewhere in the catalog that dynamically price
  // themselves off THIS service (see AnswerOption.referencedServiceId).
  referencedByAnswerOptions AnswerOption[] @relation("AnswerOptionReferencedService")

  @@map("services")
}

enum InputType {
  SINGLE_SELECT
  MULTI_SELECT
  NUMBER
  PHOTO_UPLOAD
  TEXT
}

model Question {
  id        String        @id @default(cuid())
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id])
  key       String // e.g. "wall_construction"
  prompt    String
  helpText  String?
  inputType InputType
  order     Int
  options   AnswerOption[]

  @@map("questions")
  /// Help text that only applies under a condition.
  conditionalHelp QuestionDisclaimer[]

}

enum RouteAction {
  CONTINUE // advance to nextQuestionId
  RESOLVE_INSTANT // lock in Service.basePrice (+ any priceModifier)
  RESOLVE_ADJUSTED // lock in base + priceModifier
  REMOTE_QUOTE // collect photos, create a Quote
  REROUTE_SERVICE // move to a different Service entirely, preserve answers
  REROUTE_TROUBLESHOOTING // send to the $249 diagnostic flow
  PHOTO_REVIEW // require photos before a price can be confirmed
}

model AnswerOption {
  id                 String      @id @default(cuid())
  questionId         String
  question           Question    @relation(fields: [questionId], references: [id])
  label              String // shown to the homeowner
  value              String
  priceModifierCents Int         @default(0)
  nextQuestionId     String? // for CONTINUE
  routeAction        RouteAction
  rerouteServiceId   String? // for REROUTE_SERVICE
  // Only populated when routeAction = PHOTO_REVIEW or REMOTE_QUOTE, and only
  // when the photo affects price/eligibility/routing (universal photo rule).
  requiredPhotoLabels String[]
  order              Int
  // Shown alongside the price when this branch resolves (RESOLVE_INSTANT
  // or RESOLVE_ADJUSTED) — for terms the customer needs to see before
  // booking, e.g. "we cut sheetrock; patching/painting is not included."
  // Null on the vast majority of options; only set where a real caveat
  // applies.
  disclaimer         String?
  // When set, this option's price adjustment comes from the REFERENCED
  // service's live basePrice at request time — not the static
  // priceModifierCents value. Use this whenever an answer option is
  // literally selling another catalog item (e.g. "add Elite Tilt Mount"
  // inside the TV Installation tree should always reflect whatever the
  // Elite Tilt Mount service's own price currently is, editable from the
  // admin panel, not a frozen number baked in at seed time).
  // priceModifierCents still applies as a fallback if this is null.
  referencedServiceId String?
  referencedService   Service?    @relation("AnswerOptionReferencedService", fields: [referencedServiceId], references: [id])
  // Only meaningful when routeAction = PHOTO_REVIEW. True (the default, and
  // the behaviour every option had before this field existed) means the
  // photos gate the booking: the customer submits them, the office prices
  // the job, and no scheduling happens until we reply.
  //
  // False means the price is already locked and the photos are PREPARATION,
  // not a condition — the customer sees their price, uploads the photos, and
  // books immediately. Use it wherever the answer already determines the
  // price but the tech still needs to see the space (panel make/model,
  // access, existing fixture) to arrive with the right parts.
  photosBlockBooking Boolean     @default(true)

  /// Pictures of what this option means.
  ///
  /// For questions where the honest answer is "I'd know it if I saw it".
  /// A homeowner cannot reliably say whether their fixture counts as a
  /// chandelier, is multi-tier, or has "significant assembly" — those are
  /// trade words. They can look at three photographs and pick the one that
  /// resembles the thing above their table.
  ///
  /// Several per option on purpose: one example reads as a specification
  /// ("mine isn't exactly that, so no"), three read as a category.
  illustrationUrls String[]
  // --- Branch-level job overrides ---------------------------------------
  // Some answers change the JOB, not just the price. The TV size question is
  // the clearest case: up to 55 in is a one-technician route, 56-85 in is a
  // two-technician route at the same 90-minute duration. Technician count
  // doubles both the labor hours and the dispatch capacity consumed, so it
  // can't be a service-level constant.
  // NULL means "inherit from the Service". Set only where the branch really
  // changes the work.
  // --- Branch-level ABSOLUTE overrides ----------------------------------
  // Replace the service's value outright. TV Installation: the 56-85 in answer
  // sets techCount 2 while calendar duration stays 90 minutes.
  overrideEstimatedMinutes Int?
  overrideTechCount        Int?
  overrideFieldLaborHours  Float?

  // --- Branch-level ADDITIVE deltas -------------------------------------
  // Stack onto the accumulated configuration rather than replacing it. Use
  // these for one-off adjustments; use JobComponent for anything reused
  // across services.
  //
  // These are inputs, not prices. The engine accumulates hours, material and
  // minutes across the whole route and prices the finished configuration once
  // — so the $250 primary minimum is applied to the complete job, never
  // separately to each switch leg or dimmer.
  addFieldLaborHours   Float?
  addMaterialCostCents Int?
  addScheduleMinutes   Int?

  /// Extra caveat shown ONLY when the route established earlier is FINISHED.
  ///
  /// Some consequences are true either way and some aren't. Picking up power
  /// at an existing fixture always means sharing its switch — but it only
  /// means opening the ceiling when there's no attic to work from. Putting
  /// both in one string tells attic customers we'll cut their ceiling when we
  /// won't, which is the opposite of the problem disclaimers exist to solve.
  ///
  /// Rendered after the main disclaimer, so the two read as one paragraph.
  accessFinishedDisclaimer String?

  /// What this answer means for wiring access, if it's an access answer.
  ///
  /// Null on most answers. Set on any answer to a route-access question so
  /// shared components can condition on meaning rather than on this service's
  /// particular wording.
  ///
  /// Two answers can share a classification and stay separate answers —
  /// "unfinished basement" and "basement with a drop ceiling" both price as
  /// ACCESSIBLE, but the job sheet still says which. Reclassifying later is
  /// one field on one option, with no migration of past bookings.
  accessClassification AccessClassification?

  /// Customer-facing incremental price for this answer's components, in
  /// cents, once an admin has approved it.
  ///
  /// NULL means "not yet approved" — which is NOT the same as zero. A route
  /// that selects components but has no approved increment must go to review
  /// rather than publish a calculated figure, because calculated prices are
  /// recommendations only. Zero is a legitimate approved value: a component
  /// that adds work but no charge.
  ///
  /// Distinct from priceModifierCents, which is the legacy flat modifier and
  /// stays as-is for trees that predate components.
  approvedComponentPriceCents Int?

  /// Named reusable components selected by this answer (§13-§14).
  components AnswerOptionComponent[]

  /// Conditional text attached to this answer — rendered only when its
  /// condition holds. Supersedes accessFinishedDisclaimer, which stays for
  /// now so existing trees keep working.
  conditionalDisclaimers AnswerOptionDisclaimer[]

  /// Reusable photo groups requested by this answer. Preferred over writing
  /// labels into requiredPhotoLabels: the group carries the wording and the
  /// safety note, so both stay consistent everywhere they appear.
  ///
  /// requiredPhotoLabels is retained for one-off labels that genuinely belong
  /// to a single answer. When both are present the engine shows the groups
  /// first, then the loose labels.
  photoGroups AnswerOptionPhotoGroup[]

  @@map("answer_options")
}

model PricingRule {
  id                    String  @id @default(cuid())
  serviceId             String
  service               Service @relation(fields: [serviceId], references: [id])
  condition             String // human-readable / evaluated condition key
  adjustedPriceCents    Int?
  adjustedWhileWeThereCents Int?
  // Cross-service inheritance, e.g. Garage Door Opener Outlet inherits
  // New 120V Outlet's two-tier pricing instead of duplicating it.
  inheritsFromServiceId String?

  @@map("pricing_rules")
}

// ---------------------------------------------------------------------------
// Cart / Booking
// ---------------------------------------------------------------------------

model Customer {
  id        String     @id @default(cuid())
  name      String?
  email     String?
  phone     String?
  createdAt DateTime   @default(now())
  visits    Visit[]
  quotes    Quote[]
  bookings  Booking[]

  @@map("customers")
}

enum VisitStatus {
  OPEN
  CHECKED_OUT
  ABANDONED
}

model Visit {
  id         String      @id @default(cuid())
  sessionId  String?
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  status     VisitStatus @default(OPEN)
  lineItems  LineItem[]
  booking    Booking?
  createdAt  DateTime    @default(now())

  @@map("visits")
  quotes    Quote[]
}

model LineItem {
  id             String  @id @default(cuid())
  visitId        String
  visit          Visit   @relation(fields: [visitId], references: [id])
  serviceId      String
  service        Service @relation(fields: [serviceId], references: [id])
  isPrimary      Boolean @default(true) // false = While We're There add-on
  answersSnapshot Json

  /// NULL means the price isn't settled yet — the customer hit a branch we
  /// can't price from answers alone, and the office quotes it from photos.
  ///
  /// Was non-nullable, which forced the review path to abandon the visit and
  /// create a standalone Quote instead. A customer wanting one unpriceable
  /// thing and three straightforward ones ended up booking none of them.
  computedPriceCents Int?

  /// The job as the SERVER resolved it, not as the service defines it.
  ///
  /// A route changes duration, crew-hours, components and access — six
  /// recessed lights are not one recessed light. This used to snapshot the
  /// service-level estimatedMinutes, so a six-light job booked the same
  /// calendar slot as a one-light job.
  ///
  /// Immutable once written: a booked job is never recalculated when admin
  /// pricing or labor changes later.
  resolvedCrewHours     Float?
  /// Elite vans, not people. One van is a lead and a helper.
  resolvedCrewCount     Int?
  resolvedAccessClass   AccessClassification?
  /// Component keys that priced this line — for the job sheet and for audit.
  resolvedComponentKeys String[]

  /// The running total at the point the flow stopped.
  ///
  /// Always a FLOOR, never an estimate. Every review branch exists because
  /// something makes the job more expensive — a longer run, a finished wall,
  /// a bigger TV — so the final price can only go up from here. Shown as
  /// "From $X" so the customer has a number to reason about without being
  /// told something that might turn out to be wrong.
  floorPriceCents Int?
  // INTERNAL ONLY — snapshotted from Service.estimatedMinutes at add-time,
  // same pattern as computedPriceCents. Never returned by any customer-
  // facing API. Used to total up technician time for a Booking.
  estimatedMinutes Int?
  // Photos collected at add-to-visit time on a price-locked PHOTO_REVIEW
  // branch. Distinct from Quote photos: there is no Quote in this path —
  // the price was already settled, so these ride along with the line item
  // for the technician rather than for the office to price from.
  photos          Photo[]

  @@map("line_items")
  /// Set when this line is waiting on a quoted price.
  quote     Quote?
}

enum PaymentModel {
  CARD_ON_FILE_CAPTURE_AFTER_COMPLETION // standard flat-rate bookings
  TROUBLESHOOTING_CARD_ON_FILE
  REMOTE_QUOTE_NO_UPFRONT
}

enum BookingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Booking {
  id              String        @id @default(cuid())
  visitId         String        @unique
  visit           Visit         @relation(fields: [visitId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  address         String
  zipCode         String
  arrivalWindowId String
  arrivalWindow   ArrivalWindow @relation(fields: [arrivalWindowId], references: [id])
  totalCents      Int
  // INTERNAL ONLY — sum of the visit's LineItem.estimatedMinutes at the
  // moment of booking. Never shown to the customer; this is dispatch/
  // scheduling data (e.g. flagging a booking that's likely to run past its
  // 3-hour arrival window). Null if any line item lacked an estimate.
  estimatedDurationMinutes Int?
  paymentModel    PaymentModel
  paymentStatus   String        @default("authorized") // authorized | captured | failed
  // Set once this booking has been pushed to Jobber as a Client + Job —
  // null means "not sent yet," presence prevents accidentally sending it twice.
  jobberJobId     String?
  status          BookingStatus @default(SCHEDULED)
  troubleshootingSession TroubleshootingSession?
  createdAt       DateTime      @default(now())

  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Remote Quotes
// ---------------------------------------------------------------------------

enum QuoteStatus {
  SUBMITTED
  IN_REVIEW
  PRICED
  APPROVED
  EXPIRED
}

model Quote {
  /// The visit this quote belongs to, when it came from someone building a
  /// booking rather than a standalone enquiry.
  visitId    String?
  visit      Visit?    @relation(fields: [visitId], references: [id])
  /// The line item holding its place in the cart. Pricing the quote fills in
  /// that line item's computedPriceCents.
  lineItemId String?   @unique
  lineItem   LineItem? @relation(fields: [lineItemId], references: [id])

  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  answersSnapshot Json
  status          QuoteStatus @default(SUBMITTED)
  quotedPriceCents Int?
  // Decided at approval time, not at submission — larger jobs may require one.
  depositRequired Boolean?
  depositCents    Int?
  photos          Photo[]
  createdAt       DateTime    @default(now())
  quotedAt        DateTime?
  approvedAt      DateTime?

  @@map("quotes")
}

enum PhotoSource {
  CUSTOMER_PRE_BOOKING
  TECHNICIAN_CLOSEOUT
}

model Photo {
  id        String      @id @default(cuid())
  quoteId   String?
  quote     Quote?      @relation(fields: [quoteId], references: [id])
  // Set instead of quoteId when the photos came from a price-locked
  // PHOTO_REVIEW branch, where the customer booked directly and no Quote
  // was ever created. Exactly one of quoteId / lineItemId is populated.
  lineItemId String?
  lineItem   LineItem?  @relation(fields: [lineItemId], references: [id])
  bookingId String?
  url       String
  label     String
  source    PhotoSource
  uploadedAt DateTime   @default(now())

  @@map("photos")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model ServiceArea {
  id       String   @id @default(cuid())
  name     String // "Monmouth County, NJ"
  zipCodes String[]
  active   Boolean  @default(true)

  @@map("service_areas")
}

model ArrivalWindow {
  id             String    @id @default(cuid())
  date           DateTime
  startTime      String // "08:00"
  endTime        String // "11:00"
  serviceAreaId  String
  capacityTotal  Int
  capacityBooked Int       @default(0)
  bookings       Booking[]

  @@map("arrival_windows")
}

// ---------------------------------------------------------------------------
// Troubleshooting ($249 diagnostic service)
// ---------------------------------------------------------------------------

model TroubleshootingSession {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  booking           Booking   @relation(fields: [bookingId], references: [id])
  minutesUsed       Int       @default(60) // first 60 min included in $249
  // Each approved +30-min increment logged with a timestamp. No customer-
  // facing approval step at launch — documented operationally by the
  // technician in the field.
  approvedIncrements Json[]   @default([])
  resolvedIssue     String?
  followupServiceId String?
  createdAt         DateTime  @default(now())

  @@map("troubleshooting_sessions")
}

// Single global row — the one dial that drives every service with labor
// composition data. Recalculating applies:
//   basePrice = CEILING(MAX(primaryLaborUnits*targetRate + materialCost*
//     materialMultiplier + permitAdmin, primaryLaborUnits>0 ? primaryMinimum
//     : 0), roundingIncrement)
//   whileWeThereBasePrice = CEILING(addOnLaborUnits*targetRate + materialCost
//     *materialMultiplier, roundingIncrement)
// — the exact formula from the client's validated pricing engine, not a
// simplified approximation.
model PricingSettings {
  id                       String   @id @default("default")
  targetRateCents          Int // revenue per productive tech-hour
  primaryMinimumCents      Int // floor for any primary price when labor units > 0
  roundingIncrementCents   Int // round every computed price up to this increment
  defaultPermitAdminCents  Int // fallback when a service has no per-row override
  updatedAt                DateTime @updatedAt

  @@map("pricing_settings")
}

// Single row — stores the OAuth tokens from authorizing this app against
// the real Elite Electric Jobber account. Access tokens expire hourly and
// get silently refreshed using the refresh token whenever the integration
// makes a call; the refresh token itself only changes if Jobber rotates
// it or the connection is re-authorized.
model JobberConnection {
  id           String   @id @default("default")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("jobber_connections")
}

// A local cache of Jobber's Users (crews/technicians), synced on demand
// via "Sync from Jobber." Jobber has no concept of "eligible for our
// website" — that flag is purely our own business logic layered on top,
// since not every Jobber user (e.g. your carpenters) should be counted
// as available capacity for electrical bookings from the site.
model JobberCrewMember {
  id                         String   @id @default(cuid())
  jobberUserId               String   @unique
  name                       String
  eligibleForWebsiteBookings Boolean  @default(false)
  lastSyncedAt               DateTime @default(now())

  @@map("jobber_crew_members")
}
