// BookEliteElectric.com — Prisma schema
// Implements the data architecture from the approved Phase 0 plan.
// Decision trees, pricing, and routing live as DATA here — not hardcoded pages.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Neon
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ServiceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  icon      String? // icon key, e.g. "outlet", "lighting", "fan"
  sortOrder Int      @default(0)
  // Lets New Outlets visually cluster near Outlets & Switches in the UI
  // without merging the underlying category/service data.
  navGroup  String?
  services  Service[]

  @@map("service_categories")
}

/// The platform's electrical taxonomy — ADR-006.
///
/// "Lighting" and "Outlets & Switches" are trade knowledge, true for every
/// electrical contractor. That is what makes them template identity, and it is
/// why the stable slug lives HERE and is never duplicated per contractor.
///
/// Carries no ordering, no grouping and no visibility. Whether a contractor
/// offers a category, what they call it and where it sits in their storefront
/// are all facts about that contractor — see ContractorCategory.
///
/// Contractor #2 is also electrical, so "Lighting" is genuinely one shared row
/// with two presentations. This distinction has a second real consumer.
model CanonicalCategory {
  id   String @id @default(cuid())
  /// Stable template identity, e.g. lighting, outlets-switches,
  /// dedicated-circuits. Never contractor-specific.
  slug String @unique
  /// The platform default. A contractor may override it for display without
  /// creating a new canonical category.
  name        String
  defaultIcon String?
  /// Platform template lifecycle — retiring a category from the library does
  /// not retire it from contractors already using it.
  active      Boolean @default(true)

  contractorCategories ContractorCategory[]

  @@map("canonical_categories")
}

/// One contractor's presentation and configuration of a canonical category.
///
/// Answers: do I offer it, what do I call it, what icon, order and grouping do
/// I use? `navGroup` in particular is storefront organisation rather than
/// electrical truth — Elite clusters New Outlets near Outlets & Switches;
/// another contractor may want New Installations / Repairs & Replacements.
model ContractorCategory {
  id                  String            @id @default(cuid())
  contractorId        String
  contractor          Contractor        @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  canonicalCategoryId String
  canonicalCategory   CanonicalCategory @relation(fields: [canonicalCategoryId], references: [id], onDelete: Restrict)

  /// Null means "use the canonical default". Present from the start even
  /// though Elite does not use it: a contractor may reasonably want
  /// "Lighting & Fixtures" where the platform says "Lighting". That is
  /// presentation, not a new canonical category.
  nameOverride String?
  iconOverride String?

  sortOrder Int     @default(0)
  navGroup  String?
  active    Boolean @default(true)

  /// Contractor services attach HERE, never to CanonicalCategory directly —
  /// visibility, order and naming belong to the contractor experience.
  services Service[]

  @@unique([contractorId, canonicalCategoryId])
  @@index([contractorId])
  @@map("contractor_categories")
}

/// Public storefront identity, mapped to exactly one contractor — ADR §2.2.
///
/// THE PROBLEM THIS SOLVES
///
/// Every public route needs to know whose catalog it is serving, and until now
/// none of them could. The tempting answer — take the requested service and
/// read its contractor — is forbidden: it authorises access to a resource
/// using that same resource, so knowing another contractor's service id would
/// silently switch tenants. Tenant identity must come from OUTSIDE the
/// request's target.
///
/// This is that outside thing. An entry point resolves to a site; the site
/// names one contractor; the contractor opens tenant context; only then does
/// any tenant-owned query run.
///
///   entry point -> site identity -> contractor context -> guarded application
///
/// ROUTING DATA, NOT TENANT DATA
///
/// Classified PLATFORM in lib/tenantGuard.ts, and it has to be: this is what
/// ESTABLISHES tenant context, so requiring context to read it would be
/// circular. It holds no customer data, no pricing and no catalog — only the
/// mapping from a public identity to a contractor.
///
/// DELIBERATELY THIN
///
/// No domains, no origins, no branding, no embed configuration. Later entry
/// points — a custom domain, an embed key — map to the same ContractorSite and
/// everything downstream is unchanged. One site per contractor is enough for
/// the pilot, but nothing here assumes it: the architecture must not depend on
/// Contractor.slug being the API tenant key.
model ContractorSite {
  id String @id @default(cuid())

  /// Opaque, stable, globally unique. What a customer-facing API request
  /// carries to say which storefront it acts for. Opaque so it reveals nothing
  /// about the contractor and can be rotated without renaming anything a
  /// customer sees.
  publicId String @unique

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  /// The hosted storefront path segment, e.g. "elite-electric" in
  /// /elite-electric/services. Globally unique because it is a public address.
  hostedSlug String @unique

  /// A retired site stops resolving. Its contractor's data is untouched.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractorId])
  @@map("contractor_sites")
}

enum BookingType {
  INSTANT // resolves to a fixed price immediately
  ADJUSTED // fixed price with defined surcharge branches
  REMOTE_QUOTE // photos + info -> office prices it -> customer approves
  TROUBLESHOOT_ONLY // the $249 diagnostic service itself
}

// Handoff §6 — every service declares one photo state.
//   NONE            no customer photos (standard powered swaps, detectors)
//   PREPARATION     photos help us arrive prepared, price already locked;
//                   pairs with AnswerOption.photosBlockBooking = false
//   REVIEW_REQUIRED photos gate the price; office reviews, then quotes
/// What a route-access answer MEANS to the pricing engine, independent of how
/// the question was worded.
///
/// Six questions across the catalog ask whether there's an open path to run
/// wiring — attic_access, ceiling_access, below_above_access, outlet_access,
/// attic_basement_access, dedicated_route_access — using three different
/// answer vocabularies. A component conditioned on "accessible" silently
/// failed to match an answer of "has_access", and the switch-leg price fell
/// through to review on three services without anyone noticing.
///
/// Rather than teaching every component every synonym, the ANSWER declares
/// what it means. Components condition on the classification, so adding a new
/// access question later requires no component changes.
///
/// The raw answer keeps its detail: a snapshot still records
/// "unfinished_basement" and the job sheet still says so. Only the pricing
/// engine works in these three terms.
enum AccessClassification {
  ACCESSIBLE
  FINISHED
  UNKNOWN
}

enum PhotoState {
  NONE
  PREPARATION
  REVIEW_REQUIRED
}

/// What homeowners typed into "tell us what you need", and what we made of it.
///
/// Doing three jobs at once, which is why it's one table:
///
///   CACHE — the same sentences repeat endlessly. "outlet not working" will
///   be typed thousands of times, and there's no reason to ask a model twice.
///
///   EVIDENCE — which services are named in words nobody uses, what work
///   people want that isn't offered, where matching is wrong. Worth more than
///   the feature itself, and across contractors it's what makes routing
///   better over time.
///
///   SAFETY AUDIT — every query that tripped the emergency screen, so the
///   patterns can be checked against what people actually write.
///
/// Stores the phrasing and nothing else. No name, no address, no session —
/// there is no reason to know WHO asked, only what was asked.
/// A contractor-owned match cache — ADR-008.
///
/// CONTRACTOR-OWNED, NOT PLATFORM-GLOBAL. The decision is recorded; pass four
/// executes it. Do not preserve the global unique below because it looks
/// deliberate — it predates multi-tenancy.
model ServiceQuery {
  id String @id @default(cuid())

  /// The contractor this cached match belongs to — ADR-008.
  ///
  /// Required. A cache row without an owner could answer anyone.
  contractorId String
  contractor   Contractor  @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  /// Lowercased, punctuation stripped, whitespace collapsed. The cache key.
  ///
  /// NOT globally unique — ADR-008, done 27 August.
  ///
  /// It was, and that made this a platform-wide cache: one answer per phrase
  /// for everyone. "install an outlet in my garage" does not resolve
  /// identically for every contractor — catalogs, slugs, scope policy and
  /// trade vocabulary all differ — so a hit from contractor A must never
  /// decide contractor B's suggestion.
  ///
  /// The real key is @@unique([contractorId, normalizedText]) below. Dropping
  /// the global one WAS the point rather than a side effect: that constraint
  /// was what stopped a second contractor from having their own row at all,
  /// so adding the compound key alongside it would have changed nothing.
  ///
  /// This also releases Service.slug. Until now the slug's global uniqueness
  /// accidentally protected the read path — a slug cached by another
  /// contractor was never found in this contractor's catalog, so the cache
  /// degraded to asking the model instead of leaking. That protection was
  /// nobody's decision. scripts/audit-tenant-migration-order.ts enforced this
  /// ordering and now permits the slug change.
  normalizedText String
  /// A few real phrasings behind that key, for reading back later.
  rawExamples String[]

  /// Slug rather than a relation: a service can be deleted and the record of
  /// people asking for it is still the useful part.
  matchedServiceSlug String?
  confidence Float?
  isEmergency Boolean @default(false)
  outOfScope  Boolean @default(false)

  timesAsked    Int @default(1)
  /// Went on to the suggested service.
  timesAccepted Int @default(0)
  /// Browsed instead — the suggestion was wrong or unconvincing.
  timesRejected Int @default(0)

  /// Which of the five ways this ended, most recently.
  ///
  ///   SUGGESTED   one service, offered directly
  ///   CLARIFIED   two or three, plus the question between them
  ///   BROWSE      nothing confident enough to offer
  ///   EMERGENCY   the safety screen fired
  ///   OUT_OF_SCOPE real work, not work we do
  ///
  /// The interesting rows are BROWSE and a SUGGESTED with high timesRejected.
  /// One says the catalog is missing something; the other says a service is
  /// named in words nobody recognises. Neither is visible any other way.
  outcome String @default("BROWSE")

  /// Whether the model answered, or the keyword fallback did.
  source String @default("fallback")

  /// Tokens and cost, accumulated. The per-query estimate was under a cent,
  /// but that was arithmetic rather than measurement — this is how we find
  /// out what it actually costs before anyone builds a business case on it.
  totalInputTokens  Int @default(0)
  totalOutputTokens Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADR-008. The real key: one cached answer per contractor per phrase.
  /// "install an outlet in my garage" does not resolve identically for every
  /// contractor, so it cannot have one shared answer.
  @@unique([contractorId, normalizedText])
  @@index([contractorId])
  @@index([matchedServiceSlug])
  @@index([isEmergency])
  @@map("service_queries")
}

/// When crews are available to be booked.
///
/// Deliberately OURS, not derived from the contractor's scheduling software.
/// A contractor's FSM might hold all sorts of shifts, on-call rotas and
/// personal calendars; what we need is the simpler question of when this
/// website may offer an appointment. Jobber then tells us who's already busy
/// inside those hours.
///
/// Singleton, like PricingSettings — id is always "default".
model BusinessHours {
  id String @id @default("default")
  /// Which contractor this configuration belongs to.
  ///
  /// Nullable for the expand phase only; required once backfilled and once
  /// the loaders read it. A configuration row with no owner must fail rather
  /// than fall back to whichever row happens to come first — a cross-tenant
  /// pricing fallback is worse than an error.
  contractorId String?  @unique
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)


  /// Days bookings may be offered. 0 = Sunday through 6 = Saturday.
  /// Also defines a "business day" for lead-time rules.
  workingDays Int[] @default([1, 2, 3, 4, 5])

  /// Wall-clock, 24h, in the contractor's local time.
  dayStart String @default("08:00")
  dayEnd   String @default("16:30")

  /// Length of an arrival window. Windows are generated from dayStart in
  /// blocks of this size; whatever is left at the end becomes the final
  /// window, which is why 8:00-16:30 in 3h blocks gives 8-11, 11-2, 2-4:30.
  windowMinutes Int @default(180)

  /// A leftover shorter than this is folded into the previous window rather
  /// than offered on its own — nobody wants a twenty-minute arrival window.
  minWindowMinutes Int @default(60)

  updatedAt DateTime @updatedAt

  @@map("business_hours")
}

/// Reference data: every ZIP code, with its town, county and state.
///
/// Not Elite's service area — the whole table, imported once. A contractor
/// then picks counties from it, which is how this works for the next
/// contractor in a different state without a code change.
///
/// `type` matters more than it looks: PO Box and single-entity ZIPs can't be
/// a home address, so they're imported but excluded from selection by
/// default. They were the source of every disagreement between sources on how
/// many ZIPs a county has.
model ZipCode {
  zip      String  @id
  city     String
  county   String
  state    String
  /// STANDARD, PO_BOX, UNIQUE, or MILITARY.
  type     String  @default("STANDARD")
  /// Population, where known. Zero or null means nobody lives there.
  population Int?

  @@index([state, county])
  @@index([county])
  @@map("zip_codes")
}

/// A part Elite buys, priced once and referenced by every service using it.
///
/// Services previously carried a single materialCostCents — the exterior GFCI
/// held 5244, with the breakdown of what that covered living only in a code
/// comment. A price rise on GFCI receptacles meant hunting through seeds for
/// which totals silently included one.
///
/// Itemized instead: change the receptacle here and every service using it
/// reprices. Invisible to customers; the pricing engine still sees one
/// assembled total per service, with the §4 tier applied to that total rather
/// than to each part.
/// A contractor using the platform.
///
/// Elite Electric & Lighting becomes one row here, not a set of assumptions
/// baked into the application. Everything the migration audit found hard-coded
/// — the phone number in the emergency message, the trade in the AI prompt,
/// the logo, the email sender — has a home on this model.
///
/// Fields are nullable while the application still reads its Elite values
/// from code. They are filled in as each hard-coded value is replaced, so the
/// cutover is incremental rather than one large switch.
model Contractor {
  id     String  @id @default(cuid())
  /// URL segment: price2book.com/elite-electric
  slug   String  @unique
  name   String
  /// Feeds the AI service finder's prompt, which currently says "a
  /// residential electrician" as a literal. A plumbing contractor needs a
  /// different word here and no find-and-replace on "Elite" would catch it.
  trade  String  @default("residential electrician")
  active Boolean @default(true)

  /// Contact identity. The phone number appears in the EMERGENCY message,
  /// which makes it the single most important string to get right per
  /// contractor.
  phone            String?
  supportEmail     String?
  websiteUrl       String?

  /// Branding. brandColors overrides the CSS custom properties in
  /// styles/globals.css; the Tailwind hex values become the fallbacks.
  logoUrl          String?
  logoWhiteUrl     String?
  brandColors      Json?

  /// Per-contractor sender identity — the decided direction, so customer mail
  /// comes from the contractor and platform mail comes from Price2Book.
  emailFromName    String?
  emailFromAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractorMaterials ContractorMaterial[]
  services            Service[]
  pricingSettings     PricingSettings?
  businessHours       BusinessHours?
  materialSettings    ContractorMaterialSettings?
  jobberConnection    JobberConnection?
  serviceAreas        ServiceArea[]
  contractorComponents ContractorComponent[]
  contractorCategories ContractorCategory[]
  contractorDisclaimers ContractorDisclaimer[]
  sites                ContractorSite[]
  serviceQueries       ServiceQuery[]
  memberships         ContractorMembership[]
  invitations         ContractorInvitation[]
  supportEvents       SupportAccessEvent[]

  @@map("contractors")
}

/// A material ROLE, owned by the platform.
///
/// "12/2 NM-B copper cable, priced per foot" is a fact about residential
/// electrical work. It is true for every contractor, and it is what a service
/// template means when it says a dedicated circuit needs WIRE_12_2.
///
/// Carries NO cost, NO supplier, NO contractor. Those are economics and they
/// belong to whoever is doing the work.
///
/// The `key` is carried across from Material unchanged. The migration audit
/// identified these keys as stable role identity used throughout the pricing
/// and seeding system, so renaming any of them would break seeds, the
/// reconciler and the template library at once.
model CanonicalMaterial {
  id     String  @id @default(cuid())
  /// WIRE_12_2, OLD_WORK_BOX, STANDARD_RECEPTACLE. Never a SKU, brand,
  /// package size or supplier item number.
  key    String  @unique
  name   String
  /// "each", "ft", "box" — the unit ServiceMaterial.quantity counts. A foot
  /// is a foot for everyone, so this is canonical rather than per-contractor.
  unit   String  @default("each")
  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractorMaterials ContractorMaterial[]
  serviceMaterials    ServiceMaterial[]

  @@map("canonical_materials")
}

/// What a material role costs ONE contractor, and eventually which exact
/// product they buy for it.
///
/// This is the layer that makes the template library work. The platform
/// template says a service needs 25 ft of WIRE_12_2. Elite says WIRE_12_2
/// costs them 72 cents a foot from a Southwire roll at Lowe's. Contractor B
/// says something completely different, from a different supplier, without
/// touching or duplicating the template.
///
/// Every field the old Material model carried that was about money, supply or
/// confidence lives here. Everything about identity stayed behind on
/// CanonicalMaterial.
model ContractorMaterial {
  id                  String            @id @default(cuid())
  contractorId        String
  contractor          Contractor        @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  canonicalMaterialId String
  canonicalMaterial   CanonicalMaterial @relation(fields: [canonicalMaterialId], references: [id], onDelete: Restrict)

  /// THE EFFECTIVE CACHED COST — what the pricing engine consumes.
  unitCostCents      Int
  /// The same cost at three more decimal places, when known precisely.
  /// See docs/MATERIAL-SUPPLIER-CATALOG.md for why milli- and not micro-cents.
  unitCostMilliCents Int?

  /// PACKAGE BASIS — how the cost was actually bought, so the invoice stays
  /// reproducible and a rounding artifact can't be mistaken for a price rise.
  packagePriceCents Int?
  packageQuantity   Float?
  packageUnit       String?

  costSource     MaterialCostSource     @default(CUSTOM)
  costConfidence MaterialCostConfidence @default(CONFIRMED)
  costStatus     MaterialCostStatus     @default(OK)
  costStatusNote String?
  costUpdatedAt  DateTime?

  /// Contractor-specific wording, when the canonical name isn't how this
  /// contractor refers to it. Null means use the canonical name.
  nameOverride String?
  notes        String?
  active       Boolean @default(true)

  supplierLinks        MaterialSupplierLink[] @relation("ContractorMaterialLinks")
  activeSupplierLinkId String?                @unique
  activeSupplierLink   MaterialSupplierLink?  @relation("ContractorMaterialActiveLink", fields: [activeSupplierLinkId], references: [id], onDelete: SetNull)
  costEvents           MaterialCostEvent[]    @relation("ContractorMaterialCostEvents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per role per contractor. A contractor cannot hold two prices for
  /// the same material role.
  @@unique([contractorId, canonicalMaterialId])
  @@index([canonicalMaterialId])
  @@map("contractor_materials")
}

/// DEPRECATED — being replaced by CanonicalMaterial + ContractorMaterial.
///
/// Kept intact during the expand phase so the application keeps running and
/// the reconciler keeps reading 108 of 108 while the data is copied across.
/// Removed only once every read path has moved and been verified. See
/// prisma/migrate-material-split-2026-08-24.ts.
model Material {
  id          String  @id @default(cuid())
  /// CANONICAL ROLE IDENTITY. Stable identifier for seeds and code, e.g.
  /// GFCI_WEATHER_RESISTANT or WIRE_12_2.
  ///
  /// This key names the ROLE a material plays in a service — "12/2 NM-B
  /// copper cable, priced per foot" — and it must NEVER depend on which
  /// supplier or product fills that role. Not a Lowe's item number, not a
  /// Southwire model, not a Graybar SKU, not a UPC.
  ///
  /// A service recipe says "a dedicated circuit needs WIRE_12_2". It must not
  /// say "a dedicated circuit needs Lowe's item #12345". Elite fills that
  /// role with a Southwire 250 ft roll from Lowe's; another contractor fills
  /// it with Cerrowire from a different supplier. Same recipe, same key,
  /// different product and cost. Supplier identity lives entirely in
  /// MaterialSupplierLink.
  ///
  /// This is also the seam along which CanonicalMaterial and
  /// ContractorMaterial separate if multi-tenancy ever arrives. Today the two
  /// are the same row because there is one contractor, and splitting them now
  /// would add a join and a table to express a 1:1. Keeping supplier identity
  /// out of this key is what keeps that split a mechanical migration rather
  /// than a rewrite. See docs/MATERIAL-SUPPLIER-CATALOG.md.
  key         String  @unique
  name        String

  /// What Elite pays per canonical unit, in cents. THE EFFECTIVE CACHED COST:
  /// this is the field the pricing engine consumes, and it keeps that role
  /// whether the cost was typed by an admin or synced from a supplier.
  /// Markup is applied downstream, never baked in here.
  unitCostCents Int

  /// The same cost at three more decimal places, when it is known precisely.
  ///
  /// A 1000 ft box of Cat6 at $189.00 is 18.9 cents per foot. The integer
  /// column above rounds that to 19, which back-computes the box to $190.00
  /// and makes the stored cost disagree with the invoice. The price effect is
  /// negligible — pennies, far inside the $5 rounding tolerance — but the
  /// disagreement is not, because it makes a rounding artifact and a real
  /// price change look identical a year later.
  ///
  /// Milli-cents, not micro-cents: an Int caps near 2.1 billion, so
  /// micro-cents would overflow above $21.47 a unit.
  ///
  /// The engine does NOT read this. It exists so the package figures below
  /// can be reproduced exactly.
  unitCostMilliCents Int?

  /// PACKAGE BASIS — how the cost was actually bought.
  ///
  /// Materials arrive as packages and are consumed as units: a 250 ft roll,
  /// a box of 100 wire nuts, a single receptacle. Storing what the package
  /// cost and how much it contained keeps the invoice reproducible, and makes
  /// "the price of a box went up" a visible event rather than an inference
  /// from a shifting per-unit figure.
  ///
  /// Null for materials whose cost was entered per unit with no package
  /// behind it.
  packagePriceCents Int?
  packageQuantity   Float?
  packageUnit       String?

  /// "each", "ft", "box" — the canonical unit ServiceMaterial.quantity counts.
  unit        String  @default("each")

  /// Where the effective cost comes from. CUSTOM means a person entered it.
  /// SUPPLIER means it is maintained by the active supplier link below.
  ///
  /// Any material may stay CUSTOM even when a supplier is the contractor
  /// default — a part bought from a local supply house doesn't stop being
  /// real because Lowe's is configured.
  costSource      MaterialCostSource     @default(CUSTOM)

  /// Whether the figure is a confirmed cost or a working assumption.
  ///
  /// The catalog has carried assumed costs before — a $8 duct connector that
  /// was never a quoted price, and network materials entered as estimates.
  /// Marking them means the reconciler can say a price rests on a guess
  /// instead of that fact living in a notes field nobody greps.
  costConfidence  MaterialCostConfidence @default(CONFIRMED)

  /// Sync health. OK, or STALE/ERROR when a supplier refresh failed.
  ///
  /// A failed refresh NEVER changes unitCostCents — the last good cost stands
  /// and the material is flagged. Nothing customer-facing moves because a
  /// request timed out.
  costStatus      MaterialCostStatus     @default(OK)
  costStatusNote  String?
  costUpdatedAt   DateTime?

  notes       String?
  active      Boolean @default(true)

  /// Supplier products mapped to this canonical role. A material may carry
  /// several — a Lowe's product and a Graybar product for the same 12/2 —
  /// with exactly one of them active.
  supplierLinks MaterialSupplierLink[] @relation("MaterialSupplierLinks")

  /// The link currently feeding unitCostCents, when costSource is SUPPLIER.
  activeSupplierLinkId String?               @unique
  activeSupplierLink   MaterialSupplierLink? @relation("MaterialActiveLink", fields: [activeSupplierLinkId], references: [id], onDelete: SetNull)

  costEvents  MaterialCostEvent[]
  services    ServiceMaterial[]

  @@map("materials")
}

/// How a material's effective cost is maintained.
enum MaterialCostSource {
  /// A person entered the figure.
  CUSTOM
  /// Maintained by the material's active supplier link.
  SUPPLIER
}

/// Whether a cost is confirmed or a working assumption.
enum MaterialCostConfidence {
  CONFIRMED
  ASSUMED
}

/// Freshness of the effective cost.
enum MaterialCostStatus {
  OK
  /// Last refresh succeeded but is older than the staleness horizon.
  STALE
  /// Last refresh failed, or the product returned no price. Cost unchanged.
  ERROR
}

/// Suppliers whose product catalogs can back a material.
///
/// Adding COOPER or GRAYBAR is an enum value plus an adapter module
/// implementing the same interface. It changes nothing about Material,
/// ServiceMaterial, or the pricing engine — which is the point of routing all
/// supplier identity through this model instead of onto Material.
enum MaterialSupplier {
  LOWES
  // COOPER
  // GRAYBAR
  // HOME_DEPOT
}

/// Outcome of the last refresh attempt against a supplier product.
enum SupplierSyncStatus {
  OK
  /// The product no longer exists in the supplier's catalog.
  NOT_FOUND
  /// The product exists but returned no price for the configured store.
  NO_PRICE
  /// Transport, auth or parse failure.
  ERROR
}

/// A supplier's product mapped to a canonical material role.
///
/// This is the ONLY place supplier identity is allowed to live. Material.key
/// stays supplier-independent; a service recipe references the key; this table
/// answers "and which product does this contractor actually buy for it".
///
/// Rows are created only when someone selects a product they use. The
/// supplier's catalog is browsed live and never bulk-imported — importing
/// every Lowe's electrical item as a Material would turn a 40-part working
/// catalog into a mirror of somebody else's inventory.
model MaterialSupplierLink {
  id         String   @id @default(cuid())
  /// DEPRECATED — replaced by contractorMaterialId below. Widened to optional
  /// so a supplier link can be created against the contractor material alone.
  /// Nothing creates one yet; making this optional now means the Lowe's
  /// adapter doesn't hit the same required-FK failure MaterialCostEvent did.
  materialId String?
  material   Material? @relation("MaterialSupplierLinks", fields: [materialId], references: [id], onDelete: Cascade)

  supplier            MaterialSupplier
  /// The supplier's own product/item identifier.
  supplierProductId   String
  supplierModelNumber String?
  supplierUpc         String?

  /// Product metadata, cached for display so the admin list doesn't need a
  /// live call to render.
  productName  String
  productUrl   String?
  brand        String?
  /// Supplier category breadcrumb, e.g. ["Electrical", "Conduit & Fittings",
  /// "EMT"]. Lets product search be constrained to electrical categories
  /// rather than returning garden hose for "connector".
  categoryPath String[]
  imageUrl     String?

  /// Store the price was quoted for. Null means a national price.
  storeId    String?
  storeLabel String?

  /// PACKAGE TRUTH. What the supplier sells and for how much: a 10 ft stick
  /// of EMT at $8.90, a 250 ft roll of 12/2. Preserved exactly as quoted.
  packagePriceCents Int
  packageQuantity   Float
  packageUnit       String

  /// The canonical unit this package converts to — must match Material.unit.
  /// $8.90 / 10 ft = 89 milli-cents... i.e. $0.89/ft.
  canonicalUnit          String
  derivedUnitCostMilliCents Int

  /// Last SUCCESSFUL price, retained across failures so an outage can never
  /// blank a cost.
  lastGoodPriceCents Int?
  lastGoodAt         DateTime?

  lastSyncedAt   DateTime?
  lastSyncStatus SupplierSyncStatus @default(OK)
  lastSyncError  String?

  /// Back-relation for Material.activeSupplierLink.
  activeForMaterial Material? @relation("MaterialActiveLink")

  /// Expand-phase parallel to materialId above. A supplier product is a
  /// contractor's choice — Elite buys Southwire from Lowe's, another
  /// contractor buys something else for the same role — so once the split
  /// completes these hang off ContractorMaterial and materialId goes.
  contractorMaterialId       String?
  contractorMaterial         ContractorMaterial? @relation("ContractorMaterialLinks", fields: [contractorMaterialId], references: [id], onDelete: Cascade)
  activeForContractorMaterial ContractorMaterial? @relation("ContractorMaterialActiveLink")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, supplier, supplierProductId, storeId])
  @@index([supplier, supplierProductId])
  @@map("material_supplier_links")
}

/// Every movement of a material's effective cost.
///
/// Written by setMaterialUnitCost in lib/materialCost.ts, whatever the caller.
///
/// This exists because live supplier costs change what the reconciler means.
/// Today "0 prices differ from the model with no recorded reason" is a real
/// signal — material costs are static, so any divergence is someone's
/// mistake. Once costs move on a sync cadence, divergence becomes the normal
/// state: every supplier price change shifts model prices while published
/// prices correctly stay put. Within a month the report would show twenty
/// legitimate mismatches and the number that caught three real bugs would be
/// noise.
///
/// These events are what let the reconciler separate "diverged because 12/2
/// went up on 14 March" from "diverged and nobody knows why". That reconciler
/// change is a later drop; the events start accumulating now so it has
/// history to read when it lands.
model MaterialCostEvent {
  id         String   @id @default(cuid())
  /// DEPRECATED — replaced by contractorMaterialId. A cost movement is always
  /// one contractor's, never the platform's.
  ///
  /// Widened to optional so new events can be written against the contractor
  /// material alone. Existing rows keep their value until the contract phase
  /// drops the column; nothing reads it any more.
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)

  contractorMaterialId String?
  contractorMaterial   ContractorMaterial? @relation("ContractorMaterialCostEvents", fields: [contractorMaterialId], references: [id], onDelete: Cascade)

  oldUnitCostCents      Int?
  newUnitCostCents      Int
  oldUnitCostMilliCents Int?
  newUnitCostMilliCents Int?

  source   MaterialCostSource
  supplier MaterialSupplier?

  /// Why the cost moved: "admin edit", "lowes sync", "seed-materials",
  /// "invoice 4471". Free text on purpose — a category list would grow a
  /// generic bucket that absorbs anything inconvenient.
  reason String
  /// Admin email, or the name of the job that did it.
  actor  String?
  /// Groups a batch of changes from one sync run.
  syncRunId String?

  /// Services whose cached total actually moved as a result.
  affectedServiceIds String[]

  createdAt DateTime @default(now())

  @@index([materialId, createdAt])
  @@index([syncRunId])
  @@map("material_cost_events")
}

/// Contractor-level material sourcing settings. Single row today.
///
/// Keyed like PricingSettings so it doesn't need reshaping when there is more
/// than one contractor — but deliberately NOT built as a tenant table now.
model ContractorMaterialSettings {
  id String @id @default("default")
  /// Which contractor this configuration belongs to.
  ///
  /// Nullable for the expand phase only; required once backfilled and once
  /// the loaders read it. A configuration row with no owner must fail rather
  /// than fall back to whichever row happens to come first — a cross-tenant
  /// pricing fallback is worse than an error.
  contractorId String?  @unique
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)


  /// What a newly created material defaults to. Individual materials may
  /// always differ.
  defaultCostSource MaterialCostSource @default(CUSTOM)
  defaultSupplier   MaterialSupplier?

  /// Which store's pricing to request. Elite's is the nearest branch to
  /// Ocean, NJ; a contractor elsewhere sets their own.
  preferredStoreId    String?
  preferredStoreLabel String?

  /// Whether a successful sync writes the new cost straight to the material.
  /// True is the intended behaviour — cost is a pricing INPUT and inputs may
  /// move freely. Published customer prices are unaffected either way; they
  /// only change when a person publishes them.
  autoApplySupplierCosts Boolean @default(true)

  syncCadenceHours     Int @default(24)
  /// Beyond this, a cost that hasn't refreshed successfully is reported as
  /// stale. "Matches the model" is weaker evidence when the input is months
  /// old.
  stalenessHorizonDays Int @default(90)

  updatedAt DateTime @updatedAt

  @@map("contractor_material_settings")
}

/// Join: how much of a material a service consumes.
model ServiceMaterial {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// DEPRECATED — replaced by canonicalMaterialId below.
  ///
  /// Widened to optional so new recipe lines can be written against the role
  /// alone. Existing rows keep their value until the contract phase drops the
  /// column; nothing reads it any more.
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  /// What the recipe actually means: this service needs this ROLE.
  ///
  /// The recipe points at the canonical role, never at a contractor's costed
  /// material. That is what lets the same recipe become a platform template —
  /// "a dedicated circuit needs 25 ft of WIRE_12_2" is true regardless of who
  /// is doing the work or what they pay for cable.
  ///
  /// Nullable only for the duration of the migration. It becomes required
  /// in the contract phase.
  canonicalMaterialId String?
  canonicalMaterial   CanonicalMaterial? @relation(fields: [canonicalMaterialId], references: [id], onDelete: Restrict)

  /// Supports fractional quantities — 2 ft of cable, half a box of staples.
  quantity   Float    @default(1)
  order      Int      @default(0)

  /// Retained while materialId still exists. Postgres treats NULLs as
  /// distinct, so this stops constraining new canonical-only rows on its own
  /// — which is why the constraint below now carries the guarantee.
  @@unique([serviceId, materialId])
  /// One line per role per service. This is the real constraint now: a recipe
  /// cannot name the same material role twice, which would double-count it.
  @@unique([serviceId, canonicalMaterialId])
  @@index([canonicalMaterialId])
  @@map("service_materials")
}

/// Reusable photo requirement groups.
///
/// Photo labels were being written out by hand in every seed script — 51
/// separate usages across four files, already with two different wordings for
/// the same panel photo. That's how the universal safety instruction ("open
/// the door only, never remove the dead front") ends up missing from one flow
/// because whoever wrote it forgot.
///
/// A group is named once and referenced. Correcting a wording, or adding the
/// safety line, happens in one place and applies everywhere.
model PhotoGroup {
  id          String  @id @default(cuid())
  /// Stable identifier used in code and seeds, e.g. PANEL_PHOTOS.
  key         String  @unique
  name        String
  /// The labels shown to the customer, in order.
  labels      String[]
  /// Prepended to every label in this group. Carries the panel safety rule so
  /// it can never be omitted by accident.
  safetyNote  String?
  active      Boolean @default(true)
  notes       String?
  options     AnswerOptionPhotoGroup[]

  @@map("photo_groups")
}

/// Join: an answer requests one or more photo groups.
model AnswerOptionPhotoGroup {
  id             String       @id @default(cuid())
  answerOptionId String
  answerOption   AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)
  photoGroupId   String
  photoGroup     PhotoGroup   @relation(fields: [photoGroupId], references: [id])
  order          Int          @default(0)

  @@unique([answerOptionId, photoGroupId])
  @@map("answer_option_photo_groups")
}

/// What a conditional disclaimer MEANS — the reusable concept, owned by the
/// platform.
///
/// "Access to a finished route may require opening surfaces" is a real
/// electrical condition, and naming it once is what lets a service template
/// attach it. The concept is trade knowledge.
///
/// Carries NO homeowner-facing text. What a contractor actually promises about
/// that condition — whether they patch, whether they paint, what language they
/// use — is contractor POLICY, and lives on ContractorDisclaimer.
///
/// That distinction is why this is split rather than classified platform like
/// PhotoGroup: one mutable shared text field would mean editing a disclaimer
/// for one contractor changes what a DIFFERENT contractor promises their
/// homeowner. Contractor #2 can legitimately answer "do you patch the holes
/// you make?" differently from Elite.
model CanonicalDisclaimer {
  id   String @id @default(cuid())
  /// Stable concept identity, e.g. EXTERIOR_WALL_CONTINGENCY_OUTLET.
  key  String @unique
  name String

  /// What the concept MEANS, for a contractor writing their own text against
  /// it. Never shown to a homeowner.
  description String?

  /// Only render when the access classification matches. Null means always.
  /// The CONDITION is part of the concept; the statement is not.
  accessClass AccessClassification?

  /// Platform template lifecycle. Retiring a concept from the library does not
  /// retire it from contractors already using it.
  active Boolean @default(true)

  contractorDisclaimers ContractorDisclaimer[]

  @@map("canonical_disclaimers")
}

/// One contractor's statement of policy for a canonical condition.
///
/// The homeowner-facing text lives HERE, deliberately. Elite may say "Patching
/// and painting are not included"; another contractor may include patching, or
/// word the scope differently. Those cannot safely share one mutable field.
model ContractorDisclaimer {
  id                    String              @id @default(cuid())
  contractorId          String
  contractor            Contractor          @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  canonicalDisclaimerId String
  canonicalDisclaimer   CanonicalDisclaimer @relation(fields: [canonicalDisclaimerId], references: [id], onDelete: Restrict)

  /// Shown to the customer when the condition holds. This contractor's words.
  text   String
  active Boolean @default(true)
  notes  String?

  questions QuestionDisclaimer[]
  options   AnswerOptionDisclaimer[]

  @@unique([contractorId, canonicalDisclaimerId])
  @@index([contractorId])
  @@map("contractor_disclaimers")
}

/// Text shown only when an earlier answer means it applies.
///
/// The fourth bespoke version of this was about to be built. Each one —
/// accessFinishedDisclaimer, the switch-leg acknowledgement, the fixture
/// acknowledgement — does the same job: show this sentence when the route
/// established earlier was finished. Written per tree, they drift; a customer
/// with an attic gets told we'll cut their ceiling because one copy wasn't
/// updated.
///
/// Defined once, attached where it applies, evaluated against the
/// classification the flow has already established.
model ConditionalDisclaimer {
  id        String @id @default(cuid())
  key       String @unique
  name      String
  /// Shown to the customer when the condition holds.
  text      String
  /// Only render when the access classification matches. Null means always.
  accessClass AccessClassification?
  active    Boolean @default(true)
  notes     String?
  options   AnswerOptionDisclaimer[]
  questions QuestionDisclaimer[]

  @@map("conditional_disclaimers")
}

/// Conditional text on a QUESTION rather than an answer — help text that's
/// only true on one route. The distance question tells customers to estimate
/// the path "through the basement or attic", which reads as nonsense once
/// they've said there isn't one.
model QuestionDisclaimer {
  id           String                @id @default(cuid())
  questionId   String
  question     Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// DEPRECATED — replaced by contractorDisclaimerId below.
  disclaimerId String
  disclaimer   ConditionalDisclaimer @relation(fields: [disclaimerId], references: [id])

  /// The contractor's policy statement for this condition. Nullable only for
  /// the duration of the migration; required in the contract phase.
  contractorDisclaimerId String?
  contractorDisclaimer   ContractorDisclaimer? @relation(fields: [contractorDisclaimerId], references: [id], onDelete: Restrict)

  /// When true this REPLACES the question's help text rather than appending
  /// to it — for cases where the default is actively wrong on this route.
  replacesHelpText Boolean @default(false)
  order        Int                   @default(0)

  @@unique([questionId, disclaimerId])
  @@map("question_disclaimers")
}

model AnswerOptionDisclaimer {
  id             String                @id @default(cuid())
  answerOptionId String
  answerOption   AnswerOption          @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)
  /// DEPRECATED — replaced by contractorDisclaimerId below.
  disclaimerId   String
  disclaimer     ConditionalDisclaimer @relation(fields: [disclaimerId], references: [id])

  /// The contractor's policy statement. Nullable during migration only.
  contractorDisclaimerId String?
  contractorDisclaimer   ContractorDisclaimer? @relation(fields: [contractorDisclaimerId], references: [id], onDelete: Restrict)

  order          Int                   @default(0)

  @@unique([answerOptionId, disclaimerId])
  @@map("answer_option_disclaimers")
}

/// Reusable named job components (handoff §13-§14).
///
/// A component is a bundle of real work — technician-hours, direct material,
/// and calendar time — that can be attached to a route without duplicating the
/// figures in every tree that needs it. §13's switch-leg values are used by
/// recessed lighting, new ceiling lights, new fans and new exterior locations;
/// defining them once means a labor revision happens in one place.
///
/// Deliberately NOT a dollar amount. A flat modifier can't be repriced when the
/// tech-hour rate changes, can't have the §4 material markup applied to it, and
/// contributes nothing to the tech-hours the job actually consumes — so
/// dispatch would stay wrong. Components carry inputs; price is derived.
/// A job component ROLE, owned by the platform.
///
/// "Fishing cable through finished walls" is a thing electrical work involves.
/// That is true for every contractor, and it is what a service template means
/// when an answer option attaches this component.
///
/// Carries NO money and no timings. What it costs, how long it takes and how
/// many people it needs are all facts about a contractor, not about the work
/// — see ContractorComponent.
///
/// Deliberately holds only identity and meaning. No recommended or benchmark
/// figures: none exist yet, and inventing them here would be building the
/// template library's job into pass two.
model CanonicalComponent {
  id   String @id @default(cuid())
  /// Stable identifier used in code and seeds, e.g.
  /// NEW_SWITCH_AND_SWITCH_LEG_ACCESSIBLE. Never a price, a contractor or a
  /// product — the same rule as CanonicalMaterial.key.
  key  String @unique
  /// Internal label for the admin editor.
  name String

  /// Optional plain-language line for the customer's scope summary, e.g.
  /// "New wall switch & control wiring". Null hides it from the customer.
  ///
  /// Canonical because the work is the same everywhere; a contractor who
  /// words it differently overrides it on their own row.
  customerFacingLabel String?

  active Boolean @default(true)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractorComponents ContractorComponent[]
  options              AnswerOptionComponent[]

  @@map("canonical_components")
}

/// What a component costs ONE contractor, and how long it takes them.
///
/// FINISHED_ROUTE adds 0.75 hours because that is how long fishing through
/// finished walls takes Elite. A contractor with different tooling takes a
/// different amount, charges a different price, and may send a different
/// number of people. None of that belongs on the shared definition.
model ContractorComponent {
  id                   String             @id @default(cuid())
  contractorId         String
  contractor           Contractor         @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  canonicalComponentId String
  canonicalComponent   CanonicalComponent @relation(fields: [canonicalComponentId], references: [id], onDelete: Restrict)

  /// Incremental technician-hours this component adds.
  addFieldLaborHours   Float @default(0)
  /// Incremental direct material cost in cents, BEFORE markup. The markup is
  /// applied to the assembled total, not per component.
  addMaterialCostCents Int   @default(0)
  /// Incremental calendar minutes. Independent of labor hours on purpose: a
  /// second technician doubles the hours without changing the clock time, and
  /// some work adds setup time without adding hours. Never derive one from
  /// the other.
  addScheduleMinutes   Int   @default(0)
  /// Rarely used — a component that changes the crew size.
  addTechCount         Int   @default(0)

  /// Approved customer-facing price for this component, in cents.
  ///
  /// NULL means not yet approved: any route selecting this component goes to
  /// review instead of publishing a calculated figure. Zero is a valid
  /// approved value for work that adds no charge.
  ///
  /// After the split this also covers a case that could not exist before — a
  /// contractor who has the component in their catalog but has never priced
  /// it. Same fail-closed answer: review, never a guess and never another
  /// contractor's figure.
  approvedPriceCents Int?

  /// Contractor wording for the customer-facing label, when the canonical one
  /// is not how they describe it. Null means use the canonical text.
  labelOverride String?

  active Boolean @default(true)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per component per contractor.
  @@unique([contractorId, canonicalComponentId])
  @@index([canonicalComponentId])
  @@map("contractor_components")
}

/// DEPRECATED — being replaced by CanonicalComponent + ContractorComponent.
///
/// Kept intact through the expand phase so the application keeps running and
/// the reconciler keeps reading 108 of 108 while the data is copied across.
/// Removed only once every read path has moved and been verified.
model JobComponent {
  id                   String  @id @default(cuid())
  /// Stable identifier used in code and seeds, e.g.
  /// NEW_SWITCH_AND_SWITCH_LEG_ACCESSIBLE
  key                  String  @unique
  /// Internal label for the admin editor.
  name                 String
  /// Optional plain-language line for the customer's scope summary, e.g.
  /// "New wall switch & control wiring". Null hides it from the customer.
  customerFacingLabel  String?
  /// Incremental technician-hours this component adds (handoff §3.1).
  addFieldLaborHours   Float   @default(0)
  /// Incremental direct material cost in cents, BEFORE markup. The §4 tier is
  /// applied to the assembled total, not per component.
  addMaterialCostCents Int     @default(0)
  /// Incremental calendar minutes. Independent of labor hours on purpose: a
  /// second technician doubles the hours without changing the clock time, and
  /// some work adds setup time without adding hours. Never derive one from
  /// the other.
  addScheduleMinutes   Int     @default(0)
  /// Rarely used — a component that changes the crew size.
  addTechCount         Int     @default(0)
  /// Approved customer-facing price for this component, in cents.
  ///
  /// Lives here rather than on the answer because the price belongs to the
  /// WORK, not to the question that selects it. §13.2's two variants —
  /// accessible and finished — are selected by the same answer but cost
  /// different amounts, so one figure on the answer could never be right for
  /// both.
  ///
  /// NULL means not yet approved: any route selecting this component goes to
  /// review instead of publishing a calculated figure. Zero is a valid
  /// approved value for work that adds no charge.
  approvedPriceCents   Int?
  active               Boolean @default(true)
  notes                String?
  options              AnswerOptionComponent[]

  @@map("job_components")
}

/// Join: an answer selects one or more components.
model AnswerOptionComponent {
  id             String       @id @default(cuid())
  answerOptionId String
  answerOption   AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)
  /// DEPRECATED — replaced by canonicalComponentId below. Both exist during
  /// the expand phase; this one goes once every read path has moved.
  componentId    String?
  component      JobComponent? @relation(fields: [componentId], references: [id])

  /// What the answer actually attaches: this ROLE.
  ///
  /// The contractor's tree points at a canonical concept, and pricing
  /// resolves through whichever contractor owns the service. That is what
  /// lets the same tree become a platform template.
  canonicalComponentId String?
  canonicalComponent   CanonicalComponent? @relation(fields: [canonicalComponentId], references: [id], onDelete: Restrict)
  /// Multiplier for per-unit components — e.g. 5 additional recessed lights
  /// against a single "additional light" component (§11-§12).
  quantity       Int          @default(1)

  /// Condition on the ACCESS CLASSIFICATION of an earlier answer rather than
  /// its raw value. Preferred for anything access-dependent: it survives
  /// rewording, and a new access question needs no component changes.
  conditionAccessClass AccessClassification?

  /// Optional condition on a PREVIOUSLY COLLECTED answer (handoff §29).
  ///
  /// §13.2 and §13.3 each define two variants of the same work — accessible
  /// versus finished — and which applies depends on the access answer the
  /// customer already gave. Asking again is explicitly forbidden, so instead
  /// one answer carries both variants, each conditioned on that earlier value.
  ///
  /// Null on both fields means the component always applies. When set, the
  /// component is included only if answers[conditionAnswerKey] equals
  /// conditionAnswerValue.
  ///
  /// If an answer carries only conditional components and NONE match — the
  /// access condition was never established — the route goes to review rather
  /// than silently booking without the work.
  conditionAnswerKey   String?
  conditionAnswerValue String?

  /// Retained while componentId exists. Postgres treats NULLs as distinct, so
  /// it stops constraining canonical-only rows on its own — the constraint
  /// below carries the guarantee now.
  @@unique([answerOptionId, componentId])
  /// One line per role per answer option. Attaching the same component twice
  /// would double-count it.
  @@unique([answerOptionId, canonicalComponentId])
  @@index([canonicalComponentId])
  @@map("answer_option_components")
}

model Service {
  id                  String          @id @default(cuid())
  slug                String          @unique
  name                String
  /// DEPRECATED — replaced by contractorCategoryId below. Retained until the
  /// contract phase; still required while reads are being switched over.
  categoryId          String
  category            ServiceCategory @relation(fields: [categoryId], references: [id])

  /// ADR-006. Nullable only for the duration of the migration; it becomes
  /// required in the contract phase, when ServiceCategory is retired.
  contractorCategoryId String?
  contractorCategory   ContractorCategory? @relation(fields: [contractorCategoryId], references: [id], onDelete: Restrict)
  bookingType         BookingType
  basePrice           Int? // cents; null when Remote Quote has no anchor price
  startingPriceLabel  String? // e.g. "From $1,295" for remote-quote services
  whileWeThereBasePrice Int?
  heroImage           String?
  shortDescription     String?
  // Optional override for the category's icon — e.g. "Outlets & Switches"
  // needs both an outlet icon and a switch icon, not one icon for the
  // whole category. Falls back to the contractor's iconOverride, then to
  // CanonicalCategory.defaultIcon — see lib/categories.ts categoryIcon().
  icon                String?
  requiresTechCount   Int             @default(1)
  // Labor/material composition, imported from the client's validated
  // pricing engine (Excel workbook, external tool). Null on any service
  // that hasn't been through that validation yet — those are simply
  // skipped by the "Recalculate All Prices" admin action rather than
  // guessed at. When present, basePrice/whileWeThereBasePrice are treated
  // as DERIVED from these numbers via PricingSettings, not independently
  // authoritative — editing base/WWT price directly in the Service Editor
  // still works, but a future recalculation will overwrite it using these.
  // --- LEGACY pricing composition (retained deliberately) ----------------
  // These reproduce the CURRENTLY PUBLISHED prices and record how those
  // numbers were reached. They are NOT real field hours: 44 of 45 services
  // store a value that doesn't equal estimatedMinutes x techs, because they
  // were back-fitted to land on a target price. Handoff §3.1 prohibits that
  // going forward, so new work uses fieldLaborHours below. Do not rename
  // these — that would assert the old numbers are measured, which they aren't.
  primaryLaborUnits   Float?
  addOnLaborUnits     Float?
  /// Which contractor's catalog this service belongs to.
  ///
  /// Services are per-contractor: Elite's catalog is Elite's, and the
  /// platform template library will be a separate concept rather than a
  /// shared pool of live services.
  ///
  /// Added so the material cost recompute can derive the owner from the
  /// service instead of being told. Without it, all three callers — both
  /// seeds and the Materials API — would each have to work out "which
  /// contractor" for themselves, and with one contractor in the database
  /// that inevitably means "look up the only one". That is the singleton
  /// pattern the migration audit flagged: it does not fail when a second
  /// contractor appears, it silently returns the wrong one.
  ///
  /// Nullable for the expand phase only. Becomes required once backfilled
  /// and once the recompute reads it — a service with no owner cannot have
  /// its material costs resolved, and must fail closed rather than guess.
  contractorId        String?
  contractor          Contractor? @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  materialCostCents   Int?

  /// Whether every material ROLE this service requires resolves to a cost
  /// for the contractor who owns it.
  ///
  /// False means the cached materialCostCents above MUST NOT be used. It is
  /// deliberately left at its previous value rather than zeroed — zeroing
  /// would be silent underpricing by another route, and this flag is what
  /// prevents the stale figure being trusted.
  ///
  ///   A homeowner-facing price may never be calculated using an unresolved
  ///   required material cost. Missing required cost = no price.
  ///
  /// This state cannot occur before the canonical/contractor material split:
  /// one row carried both the role and the cost, so a role without a cost was
  /// impossible. Afterwards it is expected — a contractor receives service
  /// definitions from the template library before entering their economics,
  /// so Contractor B starts with a catalog of roles they have not priced.
  /// That is the point of templates. What must not happen is those services
  /// quietly pricing as though the unpriced materials were free.
  ///
  /// Defaults true so every existing Elite service is unaffected: they all
  /// resolve today, and the migration verified it.
  materialCostResolved Boolean @default(true)

  /// Canonical keys with no cost for this contractor, for the admin to act
  /// on. Names the roles rather than counting them — "needs a cost for
  /// CABLE_CAT6" is actionable where "3 materials unpriced" sends someone
  /// hunting. Empty whenever materialCostResolved is true.
  unresolvedMaterialKeys String[]
  // Deliberate exception to the global material markup. NULL is the NORMAL
  // state and means "use the current rule": 30% on the first $750 of direct
  // cost, 20% above it, applied once to the assembled package. See
  // calculateMaterialSellCents in lib/pricing.ts.
  //
  // This comment previously described the retired banded tier (3.00x under
  // $10, 1.30x to $750, 1.20x above). Those bands were removed because they
  // ran backwards at the boundary — a package costing $9.99 sold for $29.97
  // while one costing $10.01 sold for $13.01.
  //
  // A non-null value means an admin intentionally overrode the markup, and
  // materialMultiplierReason should say why. Legacy values imported from the
  // workbook are NOT deliberate overrides — they're unvalidated data sitting
  // in this column. Itemizing a service's materials clears it, since that's
  // the moment its figures become real.
  materialMultiplier  Float?

  // Why the multiplier above departs from the tier. Without it, nobody can
  // tell six months from now whether a 2.5 was a business decision or
  // leftover from the import.
  materialMultiplierReason String?
  permitAdminCents    Int?
  otherDirectCostCents Int?

  // --- Handoff §3.1: real labor, separate from dispatch duration ---------
  // Actual expected technician-hours. NULL means "not yet established" — the
  // editor shows that rather than a suggested price derived from a number
  // nobody stands behind. Never populate this from estimatedMinutes.
  fieldLaborHours     Float?
  // Incremental hours once the tech is already on site. Handoff §3.4: WWT
  // pricing does NOT apply the primary service-call minimum.
  wwtLaborHours       Float?
  // False until someone has confirmed estimatedMinutes is a real dispatch
  // duration. Several look optimistic — Professional TV Installation is
  // recorded at 60 minutes for a one-tech mount-plus-receptacle-plus-cable
  // package — so they're treated as unreviewed until checked.
  estimatedMinutesReviewed Boolean @default(false)
  // Handoff §3.3: the $250 service-call minimum recovers the cost of
  // originating a visit. An add-on-only item never originates one, so the
  // minimum must not apply. The two Elite TV mounts are the current example:
  // applied literally it would push a $50 mount to $315.
  isPrimaryEligible   Boolean @default(true)
  // Handoff §6 — explicit, rather than inferred from route actions.
  photoState          PhotoState @default(NONE)
  // Set when an admin explicitly approves a calculated price for publication.
  // Handoff §5/§31: calculated prices are recommendations; nothing overwrites
  // a published price silently.
  publishedPriceApprovedAt DateTime?

  /// Itemized materials. When any exist they are the source of truth and
  /// materialCostCents is derived from them; the flat field remains for
  /// services not yet itemized.
  materials ServiceMaterial[]

  /// Display order within its category. Services previously sorted by name,
  /// which put "200-Amp Service Upgrade" above everything alphabetically
  /// regardless of how often anyone books it.
  sortOrder Int @default(0)
  active              Boolean         @default(true)
  // Shown alongside the price on services with NO question tree at all —
  // a flat price that still needs a caveat attached (e.g. "we don't move
  // built-in ovens"). AnswerOption.disclaimer covers the same need for
  // services that DO branch; this covers the simple flat-price case where
  // there's no branch to attach it to.
  disclaimer          String?
  // INTERNAL ONLY — never exposed in any customer-facing API response.
  // Used to estimate technician time on-site for scheduling/dispatch.
  // The guided-flow answers can push a job into a harder tier (e.g. New
  // Outlet's finished-wall-fishing branch), but this single estimate is a
  // per-service baseline; a future refinement could vary it per branch the
  // same way pricing does.
  estimatedMinutes    Int?

  questions    Question[]
  pricingRules PricingRule[]
  lineItems    LineItem[]
  quotes       Quote[]
  // Answer options elsewhere in the catalog that dynamically price
  // themselves off THIS service (see AnswerOption.referencedServiceId).
  referencedByAnswerOptions AnswerOption[] @relation("AnswerOptionReferencedService")

  @@map("services")
}

enum InputType {
  SINGLE_SELECT
  MULTI_SELECT
  NUMBER
  PHOTO_UPLOAD
  TEXT
}

model Question {
  id        String        @id @default(cuid())
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id])
  key       String // e.g. "wall_construction"
  prompt    String
  helpText  String?
  inputType InputType
  order     Int
  options   AnswerOption[]

  @@map("questions")
  /// Help text that only applies under a condition.
  conditionalHelp QuestionDisclaimer[]

}

enum RouteAction {
  CONTINUE // advance to nextQuestionId
  RESOLVE_INSTANT // lock in Service.basePrice (+ any priceModifier)
  RESOLVE_ADJUSTED // lock in base + priceModifier
  REMOTE_QUOTE // collect photos, create a Quote
  REROUTE_SERVICE // move to a different Service entirely, preserve answers
  REROUTE_TROUBLESHOOTING // send to the $249 diagnostic flow
  PHOTO_REVIEW // require photos before a price can be confirmed
}

model AnswerOption {
  id                 String      @id @default(cuid())
  questionId         String
  question           Question    @relation(fields: [questionId], references: [id])
  label              String // shown to the homeowner
  value              String
  priceModifierCents Int         @default(0)
  nextQuestionId     String? // for CONTINUE
  routeAction        RouteAction
  rerouteServiceId   String? // for REROUTE_SERVICE
  // Only populated when routeAction = PHOTO_REVIEW or REMOTE_QUOTE, and only
  // when the photo affects price/eligibility/routing (universal photo rule).
  requiredPhotoLabels String[]
  order              Int
  // Shown alongside the price when this branch resolves (RESOLVE_INSTANT
  // or RESOLVE_ADJUSTED) — for terms the customer needs to see before
  // booking, e.g. "we cut sheetrock; patching/painting is not included."
  // Null on the vast majority of options; only set where a real caveat
  // applies.
  disclaimer         String?
  // When set, this option's price adjustment comes from the REFERENCED
  // service's live basePrice at request time — not the static
  // priceModifierCents value. Use this whenever an answer option is
  // literally selling another catalog item (e.g. "add Elite Tilt Mount"
  // inside the TV Installation tree should always reflect whatever the
  // Elite Tilt Mount service's own price currently is, editable from the
  // admin panel, not a frozen number baked in at seed time).
  // priceModifierCents still applies as a fallback if this is null.
  referencedServiceId String?
  referencedService   Service?    @relation("AnswerOptionReferencedService", fields: [referencedServiceId], references: [id])
  // Only meaningful when routeAction = PHOTO_REVIEW. True (the default, and
  // the behaviour every option had before this field existed) means the
  // photos gate the booking: the customer submits them, the office prices
  // the job, and no scheduling happens until we reply.
  //
  // False means the price is already locked and the photos are PREPARATION,
  // not a condition — the customer sees their price, uploads the photos, and
  // books immediately. Use it wherever the answer already determines the
  // price but the tech still needs to see the space (panel make/model,
  // access, existing fixture) to arrive with the right parts.
  photosBlockBooking Boolean     @default(true)

  /// Pictures of what this option means.
  ///
  /// For questions where the honest answer is "I'd know it if I saw it".
  /// A homeowner cannot reliably say whether their fixture counts as a
  /// chandelier, is multi-tier, or has "significant assembly" — those are
  /// trade words. They can look at three photographs and pick the one that
  /// resembles the thing above their table.
  ///
  /// Several per option on purpose: one example reads as a specification
  /// ("mine isn't exactly that, so no"), three read as a category.
  illustrationUrls String[]
  // --- Branch-level job overrides ---------------------------------------
  // Some answers change the JOB, not just the price. The TV size question is
  // the clearest case: up to 55 in is a one-technician route, 56-85 in is a
  // two-technician route at the same 90-minute duration. Technician count
  // doubles both the labor hours and the dispatch capacity consumed, so it
  // can't be a service-level constant.
  // NULL means "inherit from the Service". Set only where the branch really
  // changes the work.
  // --- Branch-level ABSOLUTE overrides ----------------------------------
  // Replace the service's value outright. TV Installation: the 56-85 in answer
  // sets techCount 2 while calendar duration stays 90 minutes.
  overrideEstimatedMinutes Int?
  overrideTechCount        Int?
  overrideFieldLaborHours  Float?

  // --- Branch-level ADDITIVE deltas -------------------------------------
  // Stack onto the accumulated configuration rather than replacing it. Use
  // these for one-off adjustments; use JobComponent for anything reused
  // across services.
  //
  // These are inputs, not prices. The engine accumulates hours, material and
  // minutes across the whole route and prices the finished configuration once
  // — so the $250 primary minimum is applied to the complete job, never
  // separately to each switch leg or dimmer.
  addFieldLaborHours   Float?
  addMaterialCostCents Int?
  addScheduleMinutes   Int?

  /// Extra caveat shown ONLY when the route established earlier is FINISHED.
  ///
  /// Some consequences are true either way and some aren't. Picking up power
  /// at an existing fixture always means sharing its switch — but it only
  /// means opening the ceiling when there's no attic to work from. Putting
  /// both in one string tells attic customers we'll cut their ceiling when we
  /// won't, which is the opposite of the problem disclaimers exist to solve.
  ///
  /// Rendered after the main disclaimer, so the two read as one paragraph.
  accessFinishedDisclaimer String?

  /// What this answer means for wiring access, if it's an access answer.
  ///
  /// Null on most answers. Set on any answer to a route-access question so
  /// shared components can condition on meaning rather than on this service's
  /// particular wording.
  ///
  /// Two answers can share a classification and stay separate answers —
  /// "unfinished basement" and "basement with a drop ceiling" both price as
  /// ACCESSIBLE, but the job sheet still says which. Reclassifying later is
  /// one field on one option, with no migration of past bookings.
  accessClassification AccessClassification?

  /// Customer-facing incremental price for this answer's components, in
  /// cents, once an admin has approved it.
  ///
  /// NULL means "not yet approved" — which is NOT the same as zero. A route
  /// that selects components but has no approved increment must go to review
  /// rather than publish a calculated figure, because calculated prices are
  /// recommendations only. Zero is a legitimate approved value: a component
  /// that adds work but no charge.
  ///
  /// Distinct from priceModifierCents, which is the legacy flat modifier and
  /// stays as-is for trees that predate components.
  approvedComponentPriceCents Int?

  /// Named reusable components selected by this answer (§13-§14).
  components AnswerOptionComponent[]

  /// Conditional text attached to this answer — rendered only when its
  /// condition holds. Supersedes accessFinishedDisclaimer, which stays for
  /// now so existing trees keep working.
  conditionalDisclaimers AnswerOptionDisclaimer[]

  /// Reusable photo groups requested by this answer. Preferred over writing
  /// labels into requiredPhotoLabels: the group carries the wording and the
  /// safety note, so both stay consistent everywhere they appear.
  ///
  /// requiredPhotoLabels is retained for one-off labels that genuinely belong
  /// to a single answer. When both are present the engine shows the groups
  /// first, then the loose labels.
  photoGroups AnswerOptionPhotoGroup[]

  @@map("answer_options")
}

model PricingRule {
  id                    String  @id @default(cuid())
  serviceId             String
  service               Service @relation(fields: [serviceId], references: [id])
  condition             String // human-readable / evaluated condition key
  adjustedPriceCents    Int?
  adjustedWhileWeThereCents Int?
  // Cross-service inheritance, e.g. Garage Door Opener Outlet inherits
  // New 120V Outlet's two-tier pricing instead of duplicating it.
  inheritsFromServiceId String?

  @@map("pricing_rules")
}

// ---------------------------------------------------------------------------
// Cart / Booking
// ---------------------------------------------------------------------------

model Customer {
  id        String     @id @default(cuid())
  name      String?
  email     String?
  phone     String?
  createdAt DateTime   @default(now())
  visits    Visit[]
  quotes    Quote[]
  bookings  Booking[]

  @@map("customers")
}

enum VisitStatus {
  OPEN
  CHECKED_OUT
  ABANDONED
}

model Visit {
  id         String      @id @default(cuid())
  sessionId  String?
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  status     VisitStatus @default(OPEN)
  lineItems  LineItem[]
  booking    Booking?
  createdAt  DateTime    @default(now())

  @@map("visits")
  quotes    Quote[]
}

model LineItem {
  id             String  @id @default(cuid())
  visitId        String
  visit          Visit   @relation(fields: [visitId], references: [id])
  serviceId      String
  service        Service @relation(fields: [serviceId], references: [id])
  isPrimary      Boolean @default(true) // false = While We're There add-on
  answersSnapshot Json

  /// NULL means the price isn't settled yet — the customer hit a branch we
  /// can't price from answers alone, and the office quotes it from photos.
  ///
  /// Was non-nullable, which forced the review path to abandon the visit and
  /// create a standalone Quote instead. A customer wanting one unpriceable
  /// thing and three straightforward ones ended up booking none of them.
  computedPriceCents Int?

  /// The job as the SERVER resolved it, not as the service defines it.
  ///
  /// A route changes duration, crew-hours, components and access — six
  /// recessed lights are not one recessed light. This used to snapshot the
  /// service-level estimatedMinutes, so a six-light job booked the same
  /// calendar slot as a one-light job.
  ///
  /// Immutable once written: a booked job is never recalculated when admin
  /// pricing or labor changes later.
  resolvedCrewHours     Float?
  /// Elite vans, not people. One van is a lead and a helper.
  resolvedCrewCount     Int?
  resolvedAccessClass   AccessClassification?
  /// Component keys that priced this line — for the job sheet and for audit.
  resolvedComponentKeys String[]

  /// The running total at the point the flow stopped.
  ///
  /// Always a FLOOR, never an estimate. Every review branch exists because
  /// something makes the job more expensive — a longer run, a finished wall,
  /// a bigger TV — so the final price can only go up from here. Shown as
  /// "From $X" so the customer has a number to reason about without being
  /// told something that might turn out to be wrong.
  floorPriceCents Int?
  // INTERNAL ONLY — snapshotted from Service.estimatedMinutes at add-time,
  // same pattern as computedPriceCents. Never returned by any customer-
  // facing API. Used to total up technician time for a Booking.
  estimatedMinutes Int?
  // Photos collected at add-to-visit time on a price-locked PHOTO_REVIEW
  // branch. Distinct from Quote photos: there is no Quote in this path —
  // the price was already settled, so these ride along with the line item
  // for the technician rather than for the office to price from.
  photos          Photo[]

  @@map("line_items")
  /// Set when this line is waiting on a quoted price.
  quote     Quote?
}

enum PaymentModel {
  CARD_ON_FILE_CAPTURE_AFTER_COMPLETION // standard flat-rate bookings
  TROUBLESHOOTING_CARD_ON_FILE
  REMOTE_QUOTE_NO_UPFRONT
}

enum BookingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Booking {
  id              String        @id @default(cuid())
  visitId         String        @unique
  visit           Visit         @relation(fields: [visitId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  address         String
  zipCode         String
  arrivalWindowId String
  arrivalWindow   ArrivalWindow @relation(fields: [arrivalWindowId], references: [id])
  totalCents      Int
  // INTERNAL ONLY — sum of the visit's LineItem.estimatedMinutes at the
  // moment of booking. Never shown to the customer; this is dispatch/
  // scheduling data (e.g. flagging a booking that's likely to run past its
  // 3-hour arrival window). Null if any line item lacked an estimate.
  estimatedDurationMinutes Int?
  paymentModel    PaymentModel
  paymentStatus   String        @default("authorized") // authorized | captured | failed
  // Set once this booking has been pushed to Jobber as a Client + Job —
  // null means "not sent yet," presence prevents accidentally sending it twice.
  jobberJobId     String?
  status          BookingStatus @default(SCHEDULED)
  troubleshootingSession TroubleshootingSession?
  createdAt       DateTime      @default(now())

  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Remote Quotes
// ---------------------------------------------------------------------------

enum QuoteStatus {
  SUBMITTED
  IN_REVIEW
  PRICED
  APPROVED
  EXPIRED
}

model Quote {
  /// The visit this quote belongs to, when it came from someone building a
  /// booking rather than a standalone enquiry.
  visitId    String?
  visit      Visit?    @relation(fields: [visitId], references: [id])
  /// The line item holding its place in the cart. Pricing the quote fills in
  /// that line item's computedPriceCents.
  lineItemId String?   @unique
  lineItem   LineItem? @relation(fields: [lineItemId], references: [id])

  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  answersSnapshot Json
  status          QuoteStatus @default(SUBMITTED)
  quotedPriceCents Int?
  // Decided at approval time, not at submission — larger jobs may require one.
  depositRequired Boolean?
  depositCents    Int?
  photos          Photo[]
  createdAt       DateTime    @default(now())
  quotedAt        DateTime?
  approvedAt      DateTime?

  @@map("quotes")
}

enum PhotoSource {
  CUSTOMER_PRE_BOOKING
  TECHNICIAN_CLOSEOUT
}

model Photo {
  id        String      @id @default(cuid())
  quoteId   String?
  quote     Quote?      @relation(fields: [quoteId], references: [id])
  // Set instead of quoteId when the photos came from a price-locked
  // PHOTO_REVIEW branch, where the customer booked directly and no Quote
  // was ever created. Exactly one of quoteId / lineItemId is populated.
  lineItemId String?
  lineItem   LineItem?  @relation(fields: [lineItemId], references: [id])
  bookingId String?
  url       String
  label     String
  source    PhotoSource
  uploadedAt DateTime   @default(now())

  @@map("photos")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model ServiceArea {
  id       String   @id @default(cuid())

  /// Which contractor this area belongs to. NOT unique: a contractor may
  /// reasonably define several named areas.
  ///
  /// The ZipCode table stays global — US ZIP codes are platform reference
  /// data, not a contractor's. Ownership belongs on the area, never on the
  /// reference catalog.
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  name     String // "Monmouth County, NJ"
  zipCodes String[]
  active   Boolean  @default(true)

  @@map("service_areas")
}

model ArrivalWindow {
  id             String    @id @default(cuid())
  date           DateTime
  startTime      String // "08:00"
  endTime        String // "11:00"
  serviceAreaId  String
  capacityTotal  Int
  capacityBooked Int       @default(0)
  bookings       Booking[]

  @@map("arrival_windows")
}

// ---------------------------------------------------------------------------
// Troubleshooting ($249 diagnostic service)
// ---------------------------------------------------------------------------

model TroubleshootingSession {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  booking           Booking   @relation(fields: [bookingId], references: [id])
  minutesUsed       Int       @default(60) // first 60 min included in $249
  // Each approved +30-min increment logged with a timestamp. No customer-
  // facing approval step at launch — documented operationally by the
  // technician in the field.
  approvedIncrements Json[]   @default([])
  resolvedIssue     String?
  followupServiceId String?
  createdAt         DateTime  @default(now())

  @@map("troubleshooting_sessions")
}

// Single global row — the one dial that drives every service with labor
// composition data. Recalculating applies:
//   basePrice = CEILING(MAX(primaryLaborUnits*targetRate + materialCost*
//     materialMultiplier + permitAdmin, primaryLaborUnits>0 ? primaryMinimum
//     : 0), roundingIncrement)
//   whileWeThereBasePrice = CEILING(addOnLaborUnits*targetRate + materialCost
//     *materialMultiplier, roundingIncrement)
// — the exact formula from the client's validated pricing engine, not a
// simplified approximation.
model PricingSettings {
  id                       String   @id @default("default")
  /// Which contractor this configuration belongs to.
  ///
  /// Nullable for the expand phase only; required once backfilled and once
  /// the loaders read it. A configuration row with no owner must fail rather
  /// than fall back to whichever row happens to come first — a cross-tenant
  /// pricing fallback is worse than an error.
  contractorId String?  @unique
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  targetRateCents          Int // revenue per productive tech-hour
  primaryMinimumCents      Int // floor for any primary price when labor units > 0
  roundingIncrementCents   Int // round every computed price up to this increment
  defaultPermitAdminCents  Int // fallback when a service has no per-row override
  updatedAt                DateTime @updatedAt

  @@map("pricing_settings")
}

// Single row — stores the OAuth tokens from authorizing this app against
// the real Elite Electric Jobber account. Access tokens expire hourly and
// get silently refreshed using the refresh token whenever the integration
// makes a call; the refresh token itself only changes if Jobber rotates
// it or the connection is re-authorized.
model JobberConnection {
  id           String   @id @default("default")
  /// Which contractor this configuration belongs to.
  ///
  /// Nullable for the expand phase only; required once backfilled and once
  /// the loaders read it. A configuration row with no owner must fail rather
  /// than fall back to whichever row happens to come first — a cross-tenant
  /// pricing fallback is worse than an error.
  contractorId String?  @unique
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  accessToken  String
  refreshToken String
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("jobber_connections")
}

// A local cache of Jobber's Users (crews/technicians), synced on demand
// via "Sync from Jobber." Jobber has no concept of "eligible for our
// website" — that flag is purely our own business logic layered on top,
// since not every Jobber user (e.g. your carpenters) should be counted
// as available capacity for electrical bookings from the site.
model JobberCrewMember {
  id                         String   @id @default(cuid())
  jobberUserId               String   @unique
  name                       String
  eligibleForWebsiteBookings Boolean  @default(false)
  lastSyncedAt               DateTime @default(now())

  @@map("jobber_crew_members")
}

// ===========================================================================
// IDENTITY — generated by Better Auth. Do not hand-edit the four models below.
//
// `npx auth generate` regenerates them. The only additions Price2Book makes
// are the two back-relation lists on User, which Prisma requires for a
// relation to exist at all — they are virtual fields and create no database
// column.
//
// IF YOU RE-RUN `npx auth generate` (e.g. after adding a plugin), those two
// lines will be dropped and `prisma validate` will fail with a missing
// opposite relation. That failure is loud and the fix is to paste them back.
// It is not silent, which is why this arrangement is acceptable.
//
// Better Auth answers "who is this person?" and nothing else. Authorization
// lives in the Price2Book models further down.
// ===========================================================================

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  /// PRICE2BOOK ADDITIONS — back-relations only, no columns.
  memberships    ContractorMembership[]
  platformAccess PlatformAccess?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===========================================================================
// AUTHORIZATION — Price2Book's own. Replacing Better Auth someday means
// replacing the four models above; everything below stays.
// ===========================================================================

/// What a person may do inside ONE contractor.
///
/// A role is changed only through the dedicated membership-role path, never
/// by accepting an invitation. Invitations add people; membership management
/// changes authority.
enum ContractorRole {
  /// Company-level control: ownership transfer, removing members, future
  /// billing. Only an OWNER may invite or create another OWNER.
  OWNER
  /// Operates the contractor panel. May invite ADMINs only.
  ADMIN
}

/// Price2Book staff authorization. NOT a contractor role — staff are not
/// members of every contractor.
enum PlatformRole {
  PLATFORM_ADMIN
  // SUPPORT — narrower, added when there is someone to give it to
}

/// What a support session did.
enum SupportEventKind {
  ENTERED
  EXITED
  /// Staff changed something. Recorded separately so a read-only look is
  /// distinguishable from an intervention.
  MUTATED
}

/// Which contractors a person may access, and as what.
///
/// The join table is the point. A contractorId on User would mean one person,
/// one company — and retrofitting that after it spreads through every query
/// is expensive. An owner with two companies, a manager across brands, a
/// bookkeeper invited into several: ordinary here, painful otherwise.
model ContractorMembership {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractorId String
  contractor   Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  role         ContractorRole

  /// Provenance, deliberately NOT a relation. A deleted user must not cascade
  /// away the record of who granted access.
  invitedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One membership per person per contractor. Also what makes invitation
  /// acceptance safe against a double-click: the second insert loses.
  @@unique([userId, contractorId])
  @@index([contractorId, role])
  @@map("contractor_memberships")
}

/// An offer of access, not an identity.
///
/// Modelled explicitly rather than as a dormant User row. A half-real user who
/// has never signed in complicates account recovery, multi-company membership
/// and support.
model ContractorInvitation {
  id           String         @id @default(cuid())
  contractorId String
  contractor   Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  /// Lowercased and trimmed at write time. Comparison must use the same
  /// normalisation, or Josh@ and josh@ become two different invitations.
  email String
  role  ContractorRole

  /// SHA-256 of a high-entropy random token. The raw token exists only in the
  /// email, so a leaked database gives an attacker nothing usable.
  ///
  /// Not bcrypt: that defends a low-entropy human-chosen secret. A 32-byte
  /// random token is not guessable, and bcrypt would only add latency to
  /// every lookup.
  tokenHash String @unique

  /// Seven days. Long enough for a contractor who checks email on Sunday,
  /// short enough that a forwarded message goes stale.
  expiresAt DateTime
  /// Set inside the acceptance transaction. Non-null means spent.
  acceptedAt DateTime?
  /// Withdrawn, or superseded by a re-invite.
  revokedAt  DateTime?

  /// Provenance. Plain strings for the same reason as above.
  invitedByUserId  String
  acceptedByUserId String?

  createdAt DateTime @default(now())

  @@index([contractorId, email])
  @@index([email])
  @@map("contractor_invitations")
}

/// Price2Book staff authorization.
///
/// A separate table rather than a column on User, so the authentication
/// provider's model stays untouched and "who works for Price2Book" remains a
/// Price2Book fact.
model PlatformAccess {
  id     String       @id @default(cuid())
  /// One platform role per person.
  userId String       @unique
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   PlatformRole

  grantedByUserId String?
  grantedAt       DateTime  @default(now())
  /// Revoked rather than deleted, so the audit trail keeps its subject.
  revokedAt       DateTime?

  @@index([role])
  @@map("platform_access")
}

/// Price2Book staff touching a contractor's account.
///
/// Append-only by convention. An audit trail that can be edited is not one.
///
/// `platformUserId` is deliberately NOT a relation: deleting a staff account
/// must not delete the record of what they did.
model SupportAccessEvent {
  id             String           @id @default(cuid())
  platformUserId String
  contractorId   String
  contractor     Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  kind   SupportEventKind
  /// For MUTATED: enough detail to answer "who did this?" six months later.
  action String?
  /// Correlates ENTERED / MUTATED / EXITED into one visit.
  sessionRef String?

  occurredAt DateTime @default(now())

  @@index([contractorId, occurredAt])
  @@index([platformUserId, occurredAt])
  @@index([sessionRef])
  @@map("support_access_events")
}
